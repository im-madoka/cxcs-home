---
import IconButton from './IconButton.astro';
import { Monitor, Moon, Sun } from '@lucide/astro';
---

<div class="theme-switcher">
  <IconButton class="theme-trigger" type="button" aria-label="切换主题" aria-expanded="false" title="切换主题">
    <Sun size={16} stroke-width={1.8} class="icon-sun" />
    <Moon size={16} stroke-width={1.8} class="icon-moon" />
  </IconButton>
  <div class="theme-menu" role="menu" hidden>
    <button type="button" role="menuitem" data-theme-choice="system">
      <Monitor size={15} /> 跟随系统
    </button>
    <button type="button" role="menuitem" data-theme-choice="light">
      <Sun size={15} /> 浅色模式
    </button>
    <button type="button" role="menuitem" data-theme-choice="dark">
      <Moon size={15} /> 深色模式
    </button>
  </div>
</div>

<script>
  type ViewTransitionLike = {
    skipTransition: () => void;
    finished: Promise<void>;
  };

  let activeTransition: ViewTransitionLike | null = null;
  let isForwardingClick = false;

  const clearThemeTransition = () => {
    if (activeTransition) {
      try {
        activeTransition.skipTransition();
      } catch {}
    }
    delete document.documentElement.dataset.themeTransition;
    activeTransition = null;
  };

  const findInteractiveElementAt = (x: number, y: number): HTMLElement | null => {
    const selector = [
      'button',
      'a',
      'input',
      'select',
      'textarea',
      'summary',
      '[role="button"]',
      '[role="menuitem"]',
      '[role="link"]',
      '[data-theme-choice]',
      '.hero-mascot',
      '.theme-trigger',
    ].join(', ');

    const all = Array.from(document.querySelectorAll<HTMLElement>(selector));
    const hits: { el: HTMLElement; zIndex: number; rect: DOMRect }[] = [];

    for (const el of all) {
      const rect = el.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) continue;
      if (x < rect.left || x > rect.right || y < rect.top || y > rect.bottom) continue;

      const style = window.getComputedStyle(el);
      if (style.display === 'none' || style.visibility === 'hidden' || style.opacity === '0') continue;

      let current: HTMLElement | null = el;
      let zIndex = 0;
      while (current && current !== document.documentElement) {
        const s = window.getComputedStyle(current);
        if (s.position === 'fixed') zIndex = Math.max(zIndex, 1000);
        const parsedZ = parseInt(s.zIndex, 10);
        if (!Number.isNaN(parsedZ)) {
          zIndex = Math.max(zIndex, parsedZ);
        }
        current = current.parentElement;
      }

      hits.push({ el, zIndex, rect });
    }

    if (hits.length === 0) return null;

    hits.sort((a, b) => {
      if (b.zIndex !== a.zIndex) return b.zIndex - a.zIndex;
      const aArea = a.rect.width * a.rect.height;
      const bArea = b.rect.width * b.rect.height;
      if (aArea !== bArea) return aArea - bArea;
      return a.el.compareDocumentPosition(b.el) & Node.DOCUMENT_POSITION_PRECEDING ? -1 : 1;
    });

    return hits[0].el;
  };

  // When a full-page view transition is active, browsers disable hit-testing on the page DOM.
  // We capture click events on window, locate the target interactive element, skip the transition
  // so the page is immediately unblocked, and trigger the action immediately.
  window.addEventListener(
    'click',
    (event) => {
      if (isForwardingClick || !activeTransition) return;

      const rawTarget = event.target instanceof HTMLElement ? event.target : null;
      const isDirectHit = rawTarget && rawTarget !== document.documentElement && rawTarget !== document.body;
      const target = isDirectHit ? rawTarget : findInteractiveElementAt(event.clientX, event.clientY);

      if (target) {
        clearThemeTransition();

        if (!isDirectHit) {
          isForwardingClick = true;
          try {
            if (typeof target.focus === 'function' && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')) {
              target.focus();
            }
            target.click();
          } finally {
            isForwardingClick = false;
          }
        }
      }
    },
    true,
  );

  const updateThemeUI = (currentChoice: string) => {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((btn) => {
      const isSelected = btn.dataset.themeChoice === currentChoice;
      btn.setAttribute('aria-selected', String(isSelected));
      btn.classList.toggle('is-active', isSelected);
    });
  };

  const closeAllMenus = () => {
    document.querySelectorAll<HTMLElement>('.theme-switcher').forEach((sw) => {
      const menu = sw.querySelector<HTMLElement>('.theme-menu');
      const trigger = sw.querySelector<HTMLButtonElement>('.theme-trigger');
      if (menu) menu.hidden = true;
      trigger?.setAttribute('aria-expanded', 'false');
    });
  };

  const setTheme = (choice: string | undefined, x = window.innerWidth / 2, y = 24) => {
    if (!choice) return;

    const currentChoice = document.documentElement.dataset.theme || 'system';
    const isSystemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const getEffectiveTheme = (val: string) => (val === 'system' ? (isSystemDark ? 'dark' : 'light') : val);

    const apply = () => {
      document.documentElement.dataset.theme = choice;
      try {
        localStorage.setItem('cxcs-theme', choice);
      } catch {}
      updateThemeUI(choice);
    };

    if (choice === currentChoice || getEffectiveTheme(choice) === getEffectiveTheme(currentChoice)) {
      apply();
      closeAllMenus();
      return;
    }

    if (activeTransition) {
      clearThemeTransition();
    }

    if (document.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.style.setProperty('--theme-x', `${x}px`);
      document.documentElement.style.setProperty('--theme-y', `${y}px`);
      document.documentElement.dataset.themeTransition = 'true';
      try {
        const vt = document.startViewTransition(apply) as unknown as ViewTransitionLike;
        activeTransition = vt;
        vt.finished.finally(() => {
          // An interrupted transition must not clear its replacement's animation state.
          if (activeTransition === vt) {
            activeTransition = null;
            delete document.documentElement.dataset.themeTransition;
          }
        });
      } catch {
        clearThemeTransition();
        apply();
      }
    } else {
      clearThemeTransition();
      apply();
    }
    closeAllMenus();
  };

  const syncThemeUI = () => updateThemeUI(document.documentElement.dataset.theme || 'system');

  document.addEventListener('astro:before-preparation', clearThemeTransition);
  document.addEventListener('astro:before-swap', (event) => {
    const currentTheme = document.documentElement.dataset.theme || 'system';
    event.newDocument.documentElement.dataset.theme = currentTheme;
    clearThemeTransition();
  });
  document.addEventListener('astro:page-load', syncThemeUI);

  // Delegate controls so the same handlers continue working after an Astro page swap.
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const choiceButton = target?.closest<HTMLButtonElement>('[data-theme-choice]');
    if (choiceButton) {
      event.stopPropagation();
      const rect = choiceButton.getBoundingClientRect();
      setTheme(choiceButton.dataset.themeChoice, rect.left + rect.width / 2, rect.top + rect.height / 2);
      return;
    }

    const trigger = target?.closest<HTMLButtonElement>('.theme-trigger');
    if (!trigger) return;
    event.stopPropagation();
    const menu = trigger.closest<HTMLElement>('.theme-switcher')?.querySelector<HTMLDivElement>('.theme-menu');
    const rect = trigger.getBoundingClientRect();
    const isCurrentlyHidden = menu ? menu.hidden : true;
    closeAllMenus();
    if (menu) {
      menu.hidden = !isCurrentlyHidden;
      trigger.setAttribute('aria-expanded', String(!menu.hidden));
      if (!menu.hidden) menu.querySelector('button')?.focus();
    }
    document.documentElement.style.setProperty('--theme-x', `${rect.left + rect.width / 2}px`);
    document.documentElement.style.setProperty('--theme-y', `${rect.top + rect.height / 2}px`);
  });

  // Outside click/tap to close dropdown menus
  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Node) {
      const isInsideSwitcher = Array.from(document.querySelectorAll('.theme-switcher')).some((sw) =>
        sw.contains(event.target as Node),
      );
      if (!isInsideSwitcher) {
        closeAllMenus();
      }
    }
  });

  syncThemeUI();
</script>

<style>
  .theme-switcher {
    position: relative;
  }
  .theme-trigger .icon-sun,
  .theme-trigger .icon-moon {
    display: none;
  }
  :global(:root[data-theme='light']) .theme-trigger .icon-sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme-trigger .icon-moon {
    display: block;
  }
  :global(:root[data-theme='system']) .theme-trigger .icon-sun {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root[data-theme='system']) .theme-trigger .icon-sun {
      display: none;
    }
    :global(:root[data-theme='system']) .theme-trigger .icon-moon {
      display: block;
    }
  }
  .theme-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    width: 130px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    box-shadow: var(--shadow);
    z-index: 100;
  }
  .theme-menu[hidden] {
    display: none;
  }
  .theme-menu button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font-size: 12px;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .theme-menu button:hover {
    background: var(--surface-strong);
    color: var(--text);
  }
  .theme-menu button.is-active,
  .theme-menu button[aria-selected='true'] {
    background: var(--ice);
    color: var(--blue);
    font-weight: 600;
  }
  :global(:root[data-theme-transition='true']::view-transition-old(root)),
  :global(:root[data-theme-transition='true']::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
  }
  :global(:root[data-theme-transition='true']::view-transition-old(root)) {
    z-index: 1;
  }
  :global(:root[data-theme-transition='true']::view-transition-new(root)) {
    z-index: 2;
    clip-path: circle(0 at var(--theme-x) var(--theme-y));
    animation: theme-reveal 2000ms cubic-bezier(0.22, 0.9, 0.25, 1) forwards;
  }
  @keyframes theme-reveal {
    to {
      clip-path: circle(150vmax at var(--theme-x) var(--theme-y));
    }
  }
</style>
