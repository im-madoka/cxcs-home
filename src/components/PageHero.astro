---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  class?: string;
}

const { eyebrow, title, description, class: className = '' } = Astro.props;
---

<section class:list={['page-hero', className]}>
  <div class="wrap">
    <div class="section-line">{eyebrow}</div>
    <h1><slot name="title">{title}</slot></h1>
    <p class="page-hero-copy">{description}</p>
    <slot name="meta" />
  </div>
</section>

<script>
  import { onPageLoad } from '../assets/scripts/page-load';
  import { reveal } from '../assets/scripts/reveal';

  onPageLoad(() => {
    const hero = document.querySelector('.page-hero');
    reveal(hero?.querySelectorAll('h1, .page-hero-copy'), {
      y: 20,
      duration: 0.65,
      stagger: 0.08,
    });
  });
</script>

<style>
  .page-hero {
    --page-hero-height: 460px;
    height: var(--page-hero-height);
    padding: calc(var(--header-height) + 40px) 0 40px;
    display: flex;
    align-items: center;
    background: var(--ice);
    border-bottom: 1px solid var(--line);
  }
  .page-hero h1 {
    font-size: clamp(38px, 4.8vw, 56px);
    line-height: 1.25;
    font-weight: 700;
    margin: 0 0 16px;
  }
  .page-hero-copy {
    font-size: 14px;
    color: var(--muted);
    max-width: 580px;
    line-height: 1.8;
    margin: 0;
  }

  @media (max-width: 520px) {
    .page-hero {
      --page-hero-height: 520px;
      padding-top: calc(var(--header-height) + 32px);
      padding-bottom: 32px;
    }
  }
</style>
