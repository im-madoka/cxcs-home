---
import IconButton from '../components/IconButton.astro';
import { ArrowUpRight, Menu, Monitor, Moon, Sun, X } from '@lucide/astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import config from '../config';
const navItems = config.nav.filter((item) => !item.external);
const externalNav = config.nav.filter((item) => item.external);
---

<header class="site-header" data-header>
  <a class="brand" href="/" aria-label="CXCS 首页">
    <img
      class="brand-emblem"
      src="/assets/brand/association-emblem.png"
      alt=""
      width="32"
      height="32"
      decoding="async"
    />
    <span class="brand-text">
      <span class="brand-wordmark" aria-hidden="true"></span>
      <span class="brand-fallback">CXCS</span>
    </span>
  </a>
  <nav class="desktop-nav" aria-label="主导航">
    {navItems.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
  <div class="header-actions">
    {externalNav.map((item) => (
      <a class="external-nav" href={item.href} target="_blank" rel="noopener noreferrer">
        {item.label} <ArrowUpRight size={13} />
      </a>
    ))}
    <ThemeSwitcher />
    <a class="header-join" href="/join">
      Join Us <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="mobile-header-tools">
    <ThemeSwitcher />
    <IconButton class="mobile-menu-button" type="button" aria-label="打开菜单" aria-expanded="false" data-menu-trigger>
      <Menu size={20} />
    </IconButton>
  </div>
</header>

<div class="mobile-overlay" data-mobile-overlay aria-hidden="true" inert>
  <div class="mobile-overlay-top">
    <a class="brand" href="/" aria-label="CXCS 首页">
      <img
        class="brand-emblem"
        src="/assets/brand/association-emblem.png"
        alt=""
        width="32"
        height="32"
        decoding="async"
      />
      <span class="brand-text">
        <span class="brand-wordmark" aria-hidden="true"></span>
        <span class="brand-fallback">CXCS</span>
      </span>
    </a>
    <IconButton type="button" aria-label="关闭菜单" data-menu-close>
      <X size={21} />
    </IconButton>
  </div>
  <nav aria-label="移动端主导航">
    {navItems.map((item) => (
      <a href={item.href}>
        {item.mobileLabel ?? item.label}
        <span aria-hidden="true">→</span>
      </a>
    ))}
    <a href="/join">
      Join Us <span aria-hidden="true">→</span>
    </a>
    {externalNav.map((item) => (
      <a href={item.href} target="_blank" rel="noopener noreferrer">
        {item.mobileLabel ?? item.label} <ArrowUpRight size={15} />
      </a>
    ))}
  </nav>
  <div class="mobile-theme-row">
    <span class="mobile-theme-label">主题模式</span>
    <div class="mobile-theme-group">
      <button type="button" class="mobile-theme-btn" data-theme-choice="system">
        <Monitor size={14} /> 系统
      </button>
      <button type="button" class="mobile-theme-btn" data-theme-choice="light">
        <Sun size={14} /> 浅色
      </button>
      <button type="button" class="mobile-theme-btn" data-theme-choice="dark">
        <Moon size={14} /> 深色
      </button>
    </div>
  </div>
  <p class="mobile-overlay-note">Learn. Build. Deploy. Share.</p>
</div>

<script>
  let cleanupHeader: (() => void) | null = null;

  const initHeader = () => {
    cleanupHeader?.();

    const header = document.querySelector<HTMLElement>('[data-header]');
    const overlay = document.querySelector<HTMLElement>('[data-mobile-overlay]');
    const openButton = document.querySelector<HTMLButtonElement>('[data-menu-trigger]');
    const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
    if (!overlay || !openButton || !closeButton) return;

    const openMenu = () => {
      overlay.classList.add('is-open');
      overlay.removeAttribute('inert');
      overlay.setAttribute('aria-hidden', 'false');
      openButton.setAttribute('aria-expanded', 'true');
      document.body.classList.add('menu-open');
      closeButton.focus();
    };
    const closeMenu = (restoreFocus = true) => {
      overlay.classList.remove('is-open');
      overlay.setAttribute('inert', '');
      overlay.setAttribute('aria-hidden', 'true');
      openButton.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-open');
      if (restoreFocus) openButton.focus();
    };
    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape' && overlay.classList.contains('is-open')) closeMenu();
    };
    const onCloseClick = () => closeMenu();
    const onLinkClick = () => closeMenu(false);
    const galleryViewport = document.querySelector<HTMLElement>('[data-gallery-viewport]');
    const syncHeader = () => {
      if (!header) return;
      header.toggleAttribute('data-scrolled', window.scrollY > 30);
      const bounds = galleryViewport?.getBoundingClientRect();
      header.toggleAttribute(
        'data-over-gallery',
        !!bounds && bounds.top < header.getBoundingClientRect().bottom && bounds.bottom > 0,
      );
    };

    openButton.addEventListener('click', openMenu);
    closeButton.addEventListener('click', onCloseClick);
    const links = Array.from(overlay.querySelectorAll('a'));
    links.forEach((link) => link.addEventListener('click', onLinkClick));
    document.addEventListener('keydown', onKeydown);
    window.addEventListener('scroll', syncHeader, { passive: true });
    window.addEventListener('resize', syncHeader, { passive: true });
    syncHeader();

    cleanupHeader = () => {
      closeMenu(false);
      openButton.removeEventListener('click', openMenu);
      closeButton.removeEventListener('click', onCloseClick);
      links.forEach((link) => link.removeEventListener('click', onLinkClick));
      document.removeEventListener('keydown', onKeydown);
      window.removeEventListener('scroll', syncHeader);
      window.removeEventListener('resize', syncHeader);
    };
  };

  document.addEventListener('astro:page-load', initHeader);
  initHeader();
</script>

<style>
  :global(body.menu-open) {
    overflow: hidden;
  }
  .site-header {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 30px;
    height: var(--header-height);
    padding: 0 clamp(20px, 4.5vw, 48px);
    transition:
      background 0.3s ease,
      backdrop-filter 0.3s ease,
      height 0.3s ease,
      border-color 0.3s ease;
  }
  .site-header[data-scrolled] {
    height: 64px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(16px);
  }
  .site-header::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: calc(100% + 80px);
    background: linear-gradient(
      to bottom,
      var(--bg) 0%,
      var(--bg) 24%,
      color-mix(in srgb, var(--bg) 82%, transparent) 48%,
      color-mix(in srgb, var(--bg) 30%, transparent) 74%,
      transparent 100%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .site-header[data-over-gallery] {
    border-color: transparent;
    background: transparent;
    backdrop-filter: none;
    transition: height 0.3s ease;
  }
  .site-header[data-over-gallery]::before {
    opacity: 1;
  }
  /* Isolate the Safari fallback so CSS optimization preserves the standard declarations. */
  @supports (-webkit-backdrop-filter: blur(16px)) {
    .site-header[data-scrolled] {
      -webkit-backdrop-filter: blur(16px);
    }
    .site-header[data-over-gallery] {
      -webkit-backdrop-filter: none;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .brand-emblem {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    object-fit: contain;
  }
  .brand-text {
    display: inline-flex;
    align-items: center;
  }
  .brand-wordmark {
    display: inline-block;
    width: 130px;
    height: 28px;
    background-color: var(--text);
    -webkit-mask: url('/assets/brand/association-wordmark.svg') left center / contain no-repeat;
    mask: url('/assets/brand/association-wordmark.svg') left center / contain no-repeat;
    transition: background-color 0.2s ease;
  }
  .brand:hover .brand-wordmark {
    background-color: var(--blue);
  }
  .brand-fallback {
    display: none;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-left: auto;
  }
  .desktop-nav a,
  .external-nav {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--muted);
    font-size: 13px;
    transition: color 0.2s ease;
  }
  .desktop-nav a:hover,
  .external-nav:hover {
    color: var(--text);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .header-join {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 15px;
    border-radius: var(--radius-sm);
    background: var(--blue);
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }
  .header-join:hover {
    transform: translateY(-2px);
    background: var(--blue-deep);
    color: #ffffff;
  }
  .header-join:active {
    transform: translateY(0);
  }
  .mobile-header-tools {
    display: none;
  }
  .mobile-menu-button,
  .mobile-overlay {
    display: none;
  }

  @media (max-width: 1000px) {
    .desktop-nav,
    .header-actions .external-nav,
    .header-actions .header-join,
    .header-actions :global(.theme-switcher) {
      display: none;
    }
    .mobile-header-tools {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-left: auto;
    }
    .mobile-menu-button {
      display: grid;
    }
    .mobile-overlay {
      position: fixed;
      inset: 0;
      z-index: 120;
      display: flex;
      flex-direction: column;
      padding: 24px clamp(20px, 5vw, 40px);
      background: var(--bg);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-10px);
      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }
    .mobile-overlay.is-open {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
    .mobile-overlay-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 40px;
    }
    .mobile-overlay nav {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .mobile-overlay nav a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 20px;
      font-weight: 600;
      color: var(--text);
      padding-bottom: 14px;
      border-bottom: 1px solid var(--line);
    }
    .mobile-theme-row {
      margin-top: auto;
      padding: 24px 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .mobile-theme-label {
      font-size: 13px;
      color: var(--muted);
    }
    .mobile-theme-group {
      display: flex;
      gap: 6px;
    }
    .mobile-theme-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 10px;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: var(--surface);
      font-size: 12px;
      cursor: pointer;
    }
    .mobile-overlay-note {
      font-size: 11px;
      color: var(--muted);
      letter-spacing: 0.05em;
    }
  }
</style>
