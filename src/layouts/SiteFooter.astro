---
import config from '../config';
const { footer: footerGroups, recruitment } = config;
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-main">
      <div class="footer-identity">
        <div class="footer-brand-wrap">
          <img
            class="seal-mark"
            src="/assets/brand/association-emblem.png"
            alt=""
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
          />
          <div
            class="footer-wordmark"
            role="img"
            aria-label="东南大学成贤学院校团委科创部大学生科学技术协会（计算机分会）"
          ></div>
        </div>
        <p class="footer-tagline">用代码赋予思想形状，以好奇探寻技术本质。</p>
      </div>

      {footerGroups.map((group) => (
        <div class="footer-group">
          <strong class="group-title">{group.title.toUpperCase()}</strong>
          <div class="footer-links">
            {group.links.map((link) => (
              <a
                href={link.href}
                target={'external' in link && link.external ? '_blank' : undefined}
                rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      ))}

      <div class="footer-group">
        <strong class="group-title">CONTACT</strong>
        <div class="footer-links">
          <span class="contact-number">QQ群：{recruitment.qqGroup}</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 东南大学成贤学院校团委科创部大学生科学技术协会（计算机分会）</span>
      <span>LEARN. BUILD. DEPLOY. SHARE.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding: 56px 0 32px;
    margin-top: auto;
  }
  .footer-main {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }
  .footer-brand-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .seal-mark {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }
  .footer-wordmark {
    display: inline-block;
    width: 140px;
    height: 28px;
    background-color: var(--text);
    -webkit-mask: url('/assets/brand/association-wordmark.svg') left center / contain no-repeat;
    mask: url('/assets/brand/association-wordmark.svg') left center / contain no-repeat;
  }
  .footer-identity p {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.8;
    margin: 0;
  }
  .footer-group .group-title {
    display: block;
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.08em;
    margin-bottom: 16px;
    font-weight: 600;
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-links a,
  .footer-links span {
    font-size: 12px;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .footer-links a:hover {
    color: var(--blue);
  }
  .footer-bottom {
    border-top: 1px solid var(--line);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 11px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-identity {
      grid-column: span 2;
    }
  }

  @media (max-width: 520px) {
    .footer {
      padding: 44px 0 28px;
    }
    .footer-main {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-bottom: 32px;
    }
    .footer-identity {
      grid-column: auto;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
