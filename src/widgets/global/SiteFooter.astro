---
import { ArrowUpRight, Github } from 'lucide-astro';
import { footerGroups, siteData } from '../../data/site';
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-brand-block">
      <img
        class="seal-mark"
        src="/assets/brand/association-emblem.png"
        alt=""
        width="64"
        height="64"
        loading="lazy"
        decoding="async"
      />
      <div class="footer-wordmark" role="img" aria-label="东南大学成贤学院校团委科创部大学生科学技术协会（计算机分会）">
      </div>
      <p class="footer-tagline">一起学习，一起折腾，<br />一起做点有意思的东西。</p>
    </div>
    {
      footerGroups.map((group) => (
        <div class="footer-group">
          <p class="eyebrow">{group.title}</p>
          <ul>
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={'external' in link && link.external ? '_blank' : undefined}
                  rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="footer-group">
      <p class="eyebrow">Contact</p>
      <span class="footer-contact">{siteData.contact || 'QQ群：870131425'}</span>
      {
        siteData.githubUrl && (
          <a class="footer-contact" href={siteData.githubUrl} target="_blank" rel="noopener noreferrer">
            <Github size={15} /> GitHub <ArrowUpRight size={13} />
          </a>
        )
      }
    </div>
  </div>
  <div class="footer-bottom"><span>© 2026 东南大学成贤学院校团委科创部大学生科学技术协会（计算机分协会）</span><span>南京 · China</span></div>
</footer>
