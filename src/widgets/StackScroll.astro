---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  /** CSS length at which the cards stick while scrolling. */
  top?: string;
}

const { top = 'var(--header-height, 72px)', class: className, style, ...attributes } = Astro.props;
const stackStyle =
  typeof style === 'string' ? `--stack-scroll-top: ${top}; ${style}` : { '--stack-scroll-top': top, ...style };
---

<div {...attributes} class:list={['stack-scroll', className]} style={stackStyle}>
  <slot />
</div>

<style>
  .stack-scroll {
    /* Each sticky card paints above earlier siblings, within this stack only. */
    isolation: isolate;
  }
</style>
