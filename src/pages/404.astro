---
import Button from '../components/Button.astro';
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../widgets/PageHero.astro';
---

<BaseLayout pagePath="/404">
  <PageHero
    eyebrow="ERROR / 404"
    title="404 · 好像走错地方了。"
    description="这个页面不存在，也可能已经被移动到了别的地方。"
    class="not-found"
  >
    <span slot="eyebrow">ERROR / 404</span>
    <Fragment slot="title">
      <span class="error-code">404</span>
      <span class="error-title">好像走错地方了。</span>
    </Fragment>
    <Fragment slot="meta">
      <div class="terminal">
        <span class="term-line">
          &gt; cd <span data-not-found-path>{Astro.url.pathname}</span>
        </span>
        <span class="term-err">
          cd: no such file or directory: <span data-not-found-path>{Astro.url.pathname}</span>
        </span>
      </div>

      <div class="error-actions">
        <Button variant="primary" href="/">
          <ArrowLeft size={14} /> 返回首页
        </Button>
        <Button variant="secondary" href="/articles">
          看看最近的内容 <ArrowRight size={14} />
        </Button>
      </div>
    </Fragment>
  </PageHero>
</BaseLayout>

<script>
  import { onPageLoad } from '../assets/scripts/page-load';

  onPageLoad(() => {
    document.querySelectorAll<HTMLElement>('[data-not-found-path]').forEach((element) => {
      element.textContent = window.location.pathname;
    });
  });
</script>

<style>
  :global(.page-hero.not-found) {
    padding: calc(var(--header-height) + 64px) 0 84px;
    height: auto;
    min-height: calc(100dvh - var(--header-height));
    align-items: center;
  }
  :global(.not-found h1) {
    margin-bottom: 12px;
  }
  .error-code {
    display: block;
    font-size: clamp(72px, 10vw, 120px);
    font-weight: 800;
    line-height: 0.9;
    color: var(--blue);
    margin: 0 0 16px;
    letter-spacing: -0.04em;
  }
  .error-title {
    display: block;
    font-size: 28px;
    font-weight: 650;
    line-height: 1.6;
  }
  :global(.not-found .page-hero-copy) {
    max-width: 480px;
    margin: 0 0 28px;
  }
  .terminal {
    overflow-wrap: anywhere;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 18px 22px;
    font-family: monospace;
    font-size: 13px;
    max-width: 460px;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .term-line {
    color: var(--blue);
  }
  .term-err {
    color: var(--muted);
  }
  .error-actions {
    display: flex;
    gap: 14px;
  }

  @media (max-width: 520px) {
    .error-actions {
      flex-direction: column;
    }
  }
</style>
