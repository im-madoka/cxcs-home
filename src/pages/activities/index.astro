---
import { getCollection } from 'astro:content';
import { CalendarDays, MapPin } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import BrandPlaceholder from '../../components/BrandPlaceholder.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import StatusPill from '../../components/StatusPill.astro';
import { siteData } from '../../data/site';
import { getActivityStatus } from '../../lib/status';
const activities = (await getCollection('activities', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.startAt.valueOf() - b.data.startAt.valueOf(),
);
const upcoming = activities.filter(
  (a) => getActivityStatus(a.data.startAt, a.data.endAt, new Date(), a.data.cancelled) === 'upcoming',
);
const past = activities
  .filter((a) => getActivityStatus(a.data.startAt, a.data.endAt, new Date(), a.data.cancelled) !== 'upcoming')
  .reverse();
---

<BaseLayout
  title={`Activities · ${siteData.shortName}`}
  description="分享会、比赛、交流、项目活动，总有一些事情比一个人折腾更有意思。"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div>
        <p class="eyebrow">Activities</p><h1>一起做点<br />有意思的事。</h1><p class="page-hero-copy">
          分享会、比赛、交流、项目活动……总有一些事情，比一个人在宿舍里折腾更有意思。
        </p>
      </div><div class="page-hero-art" aria-hidden="true"></div>
    </div>
  </section>
  <section class="band">
    <div class="container">
      <SectionIntro eyebrow="Upcoming" title="接下来，一起做什么？" />{
        upcoming.length ? (
          <div class="upcoming-list">
            {upcoming.map((activity, index) => (
              <article class={`upcoming-card ${index === 0 ? 'upcoming-featured' : ''}`}>
                <div class="upcoming-cover">
                  {activity.data.cover ? (
                    <img src={activity.data.cover.image} alt={activity.data.cover.alt} />
                  ) : (
                    <BrandPlaceholder label="ACTIVITY" />
                  )}
                </div>
                <div class="upcoming-content">
                  <StatusPill
                    status={getActivityStatus(
                      activity.data.startAt,
                      activity.data.endAt,
                      new Date(),
                      activity.data.cancelled,
                    )}
                    startAt={activity.data.startAt.toISOString()}
                    endAt={activity.data.endAt.toISOString()}
                    cancelled={activity.data.cancelled}
                  />
                  <h3>{activity.data.title}</h3>
                  <p>{activity.data.description}</p>
                  <div class="event-meta">
                    <span>
                      <CalendarDays size={15} />
                      {activity.data.startAt.toLocaleDateString('zh-CN')} ·{' '}
                      {activity.data.startAt.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}
                    </span>
                    <span>
                      <MapPin size={15} />
                      {activity.data.location.name}
                    </span>
                  </div>
                  <div class="hero-actions">
                    <ArrowLink href={`/activities/${activity.id}`} label="查看详情" />
                    {activity.data.registrationUrl && (
                      <ArrowLink href={activity.data.registrationUrl} label="报名参加" external />
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <>
              <h3>最近还没有新的活动安排。</h3>
              <p>不过可以先看看我们之前都做过些什么。</p>
            </>
          </div>
        )
      }
    </div>
  </section>
  <section class="band band-soft">
    <div class="container">
      <div class="section-head-row">
        <SectionIntro eyebrow="Past Activities" title="和大家一起做过的事。" /><span class="eyebrow"
          >Timeline / Archive</span
        >
      </div>{
        past.length ? (
          <div class="timeline">
            {past.map((activity) => (
              <article class="timeline-row">
                <div class="timeline-date">
                  {activity.data.startAt.getFullYear()}
                  <br />
                  {activity.data.startAt.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
                </div>
                <div class="timeline-card">
                  <div>
                    <StatusPill
                      status={getActivityStatus(
                        activity.data.startAt,
                        activity.data.endAt,
                        new Date(),
                        activity.data.cancelled,
                      )}
                      startAt={activity.data.startAt.toISOString()}
                      endAt={activity.data.endAt.toISOString()}
                      cancelled={activity.data.cancelled}
                    />
                    <h3>{activity.data.title}</h3>
                    <p>{activity.data.description}</p>
                    <ArrowLink href={`/activities/${activity.id}`} label="活动详情" />
                  </div>
                  {activity.data.cover ? (
                    <img src={activity.data.cover.image} alt={activity.data.cover.alt} loading="lazy" />
                  ) : (
                    <BrandPlaceholder label="PAST" />
                  )}
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <>
              <h3>活动故事还在路上。</h3>
              <p>稍后再来看看。</p>
            </>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
