---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import BrandPlaceholder from '../../components/BrandPlaceholder.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import StatusPill from '../../components/StatusPill.astro';
import { siteData } from '../../data/site';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<BaseLayout title={`Projects · ${siteData.shortName}`} description="网站、工具、平台，还有一些突然冒出来的想法。">
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div>
        <p class="eyebrow">Projects</p><h1>我们真的<br />会做点东西。</h1><p class="page-hero-copy">
          网站、工具、平台，还有一些突然冒出来的想法。
        </p>
      </div><div class="page-hero-art" aria-hidden="true"></div>
    </div>
  </section>
  <section class="band">
    <div class="container">
      <div class="section-head-row">
        <SectionIntro
          eyebrow="Featured Projects"
          title="先解决问题，再谈技术。"
          description="每个项目都从一个具体的困扰开始。"
        /><div class="tag-list"><span class="tag">全部</span><span class="tag">Featured</span></div>
      </div><div class="showcase-grid">
        {
          featured.map((project) => (
            <article class="showcase-card">
              <>
                <div class="project-image">
                  {project.data.cover ? (
                    <img src={project.data.cover.image} alt={project.data.cover.alt} />
                  ) : (
                    <BrandPlaceholder label={project.data.title} />
                  )}
                </div>
                <div class="status-block">
                  <>
                    <span class="eyebrow" style="margin:0">
                      01 / Project
                    </span>
                    <StatusPill status={project.data.status} />
                  </>
                </div>
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                <div class="project-bottom">
                  <>
                    <div class="tag-list">
                      {project.data.technologies.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                    <ArrowLink href={`/projects/${project.id}`} label="查看项目" />
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div><div class="section-head-row" style="margin-top:130px">
        <SectionIntro eyebrow="Project Collection" title="还在实验，也值得被看见。" />
      </div><div class="project-track">
        {
          rest.map((project, index) => (
            <article class="project-card">
              <>
                <div class="project-image">
                  {project.data.cover ? (
                    <img src={project.data.cover.image} alt={project.data.cover.alt} loading="lazy" />
                  ) : (
                    <BrandPlaceholder label={project.data.title} />
                  )}
                </div>
                <div class="project-meta">
                  <>
                    <span>0{index + 2} / Project</span>
                    <StatusPill status={project.data.status} />
                  </>
                </div>
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                <div class="project-bottom">
                  <>
                    <div class="tag-list">
                      {project.data.technologies.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                    <ArrowLink href={`/projects/${project.id}`} label="了解项目" />
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
