---
import { ArrowRight, ArrowUpRight, Code2, Sparkles } from 'lucide-astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import BrandPlaceholder from '../components/BrandPlaceholder.astro';
import SectionIntro from '../components/SectionIntro.astro';
import StatusPill from '../components/StatusPill.astro';
import { characters, siteData } from '../data/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
const episodes = (await getCollection('theater', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.episode - a.data.episode,
);
const featuredArticle = articles.find((entry) => entry.data.featured) || articles[0];
const latestArticles = articles.filter((entry) => entry.id !== featuredArticle?.id).slice(0, 2);
const featuredProject = projects[0];
const latestEpisode = episodes[0];
---

<BaseLayout title={siteData.title} description={siteData.description}>
  <section class="hero" id="top">
    <div class="container hero-inner">
      <div>
        <p class="hero-kicker">Computer Association · 2026</p>
        <h1>Hello,<br /><span class="accent">World.</span></h1>
        <p class="hero-copy">欢迎来到东南大学成贤学院计算机协会。<br />一起学习，一起折腾，一起做点有意思的东西。</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#what-we-do">看看我们在做什么 <ArrowRight size={16} /></a>
          <a class="button button-secondary" href="/join">加入计协 <ArrowUpRight size={16} /></a>
        </div>
        <div class="scroll-cue"><span></span> Scroll to explore</div>
      </div>
      <div class="hero-visual" aria-label="CXCS mascot visual">
        <div class="hero-visual-card">
          <div class="mascot">
            <div class="mascot-head">•ᴗ•</div><div class="mascot-body"></div><div class="mascot-pin">危</div>
          </div>
        </div>
        <p class="hero-note">平时安静，触发时有反应。<br />— 计协娘</p>
      </div>
    </div>
  </section>

  <section class="band" id="what-we-do">
    <div class="container">
      <div class="section-head-row">
        <SectionIntro
          eyebrow="02 / What We Do"
          title="所以……我们平时到底在干嘛？"
          description="简单说，就是一起把感兴趣的东西研究明白，再把想法做出来。"
        />
      </div>
      <div class="bento-grid">
        <article class="bento-card">
          <span class="card-number">01</span><h3>学点新东西</h3><p>
            编程、电脑、软件、开发板……感兴趣的东西，都可以一起研究。
          </p><span class="card-icon"><Code2 size={56} strokeWidth={1.3} /></span>
        </article>
        <article class="bento-card">
          <span class="card-number">02</span><h3>做点有意思的项目</h3><p>
            网站、小游戏、机器人、小工具。想到了，就试着把它做出来。
          </p><span class="card-icon"><Sparkles size={56} strokeWidth={1.3} /></span>
        </article>
        <article class="bento-card">
          <span class="card-number">03</span><h3>一起参加比赛</h3><p>有队友、有经验分享，也有人陪你一起踩坑。</p><span
            class="card-icon">↗</span
          >
        </article>
        <article class="bento-card">
          <span class="card-number">04</span><h3>认识一群爱折腾的人</h3><p>
            技术很重要，但找到一群志同道合的人也很重要。
          </p><span class="card-icon">⌁</span>
        </article>
      </div>
    </div>
  </section>

  <section class="band band-soft" id="start-here">
    <div class="container">
      <div class="section-head-row">
        <SectionIntro
          eyebrow="03 / Start Here"
          title="可是……我什么都不会。"
          description="那就从零开始。一步一步来，先找到一个愿意动手的理由。"
        />
      </div>
      <div class="journey">
        <article class="journey-step">
          <div class="journey-no"><span>01</span><span>Learn</span></div><h3>从零开始</h3><p>
            第一次写代码？没关系，我们准备了面向新手的学习资料。
          </p><ArrowLink href={siteData.guideUrl} label="打开 CXCS Guide" external />
        </article>
        <article class="journey-step">
          <div class="journey-no"><span>02</span><span>Build</span></div><h3>做点自己的东西</h3><p>
            学会一点之后，试着做一个真正属于自己的小项目。
          </p><ArrowLink href="/projects" label="看看大家做过什么" />
        </article>
        <article class="journey-step">
          <div class="journey-no"><span>03</span><span>Deploy</span></div><h3>把它分享出去</h3><p>
            如果你做了一个网站，还可以直接用协会的平台发布出来。
          </p><ArrowLink href={siteData.pageUrl} label="了解 CXCS Page" external />
        </article>
      </div>
    </div>
  </section>

  <section class="band" id="latest">
    <div class="container">
      <div class="section-head-row">
        <SectionIntro
          eyebrow="04 / Latest"
          title="最近发生了什么"
          description="看看 CXCS 最近都在折腾些什么。"
        /><ArrowLink href="/articles" label="浏览全部文章" />
      </div>
      {
        featuredArticle && (
          <div class="featured-layout">
            <a class="story-card" href={`/articles/${featuredArticle.id}`}>
              {featuredArticle.data.cover ? (
                <img src={featuredArticle.data.cover.image} alt={featuredArticle.data.cover.alt} loading="lazy" />
              ) : (
                <BrandPlaceholder label="LATEST" />
              )}
              <div class="story-content">
                <>
                  <div class="eyebrow">
                    {featuredArticle.data.type} · {featuredArticle.data.publishedAt.toLocaleDateString('zh-CN')}
                  </div>
                  <h3>{featuredArticle.data.title}</h3>
                  <p>{featuredArticle.data.description}</p>
                  <span class="arrow-link">
                    阅读更多 <ArrowRight size={16} />
                  </span>
                </>
              </div>
            </a>
            <div class="story-side">
              {latestArticles.map((article) => (
                <a class="mini-story" href={`/articles/${article.id}`}>
                  <div class="article-cover">
                    {article.data.cover ? (
                      <img src={article.data.cover.image} alt={article.data.cover.alt} loading="lazy" />
                    ) : (
                      <BrandPlaceholder label={article.data.type.toUpperCase()} />
                    )}
                  </div>
                  <div>
                    <div class="article-meta">
                      <span class="article-type">{article.data.type}</span>
                      <span>{article.data.publishedAt.toLocaleDateString('zh-CN')}</span>
                    </div>
                    <h3>{article.data.title}</h3>
                    <p>{article.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="band band-soft" id="projects">
    <div class="container">
      <div class="section-head-row">
        <SectionIntro
          eyebrow="05 / Projects"
          title="我们真的会做点东西。"
          description="网站、Bot、小工具，以及一些突然冒出来的奇怪想法。"
        /><ArrowLink href="/projects" label="进入项目展" />
      </div>
      <div class="project-track">
        {
          projects.slice(0, 2).map((project, index) => (
            <article class="project-card">
              <>
                <div class="project-image">
                  {project.data.cover ? (
                    <img src={project.data.cover.image} alt={project.data.cover.alt} loading="lazy" />
                  ) : (
                    <BrandPlaceholder label={project.data.title} />
                  )}
                </div>
                <div class="project-meta">
                  <>
                    <span>0{index + 1} / Project</span>
                    <StatusPill status={project.data.status} />
                  </>
                </div>
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                <div class="project-bottom">
                  <>
                    <div class="tag-list">
                      {project.data.technologies.slice(0, 3).map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                    <ArrowLink href={`/projects/${project.id}`} label="了解项目" />
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
      {
        featuredProject?.data.title === 'CXCS Page' && (
          <div class="page-process">
            <>
              <span>获取项目代码</span>
              <i>→</i>
              <span>安装项目依赖</span>
              <i>→</i>
              <span>构建完成</span>
              <i>→</i>
              <strong>网站已经上线</strong>
            </>
          </div>
        )
      }
    </div>
  </section>

  <section class="band ecosystem" id="ecosystem">
    <div class="container">
      <SectionIntro
        eyebrow="06 / CXCS Ecosystem"
        title="不只是一个协会。"
        description="我们也在搭自己的工具、内容和平台。"
      />
      <div class="ecosystem-grid">
        <a class="eco-card" href="/about"
          ><span class="eco-card-number">01 / Website</span><h3>认识我们</h3><p>
            招新、动态、活动、项目，以及正在发生的一切。
          </p><span class="eco-url">cxcs.dev <ArrowRight size={17} /></span></a
        >
        <a class="eco-card" href={siteData.guideUrl} target="_blank" rel="noopener noreferrer"
          ><span class="eco-card-number">02 / Guide</span><h3>从不会，<br />到会一点。</h3><p>
            面向新生整理的教程和学习资料。
          </p><span class="eco-url">guide.cxcs.dev <ArrowUpRight size={17} /></span></a
        >
        <a class="eco-card" href={siteData.pageUrl} target="_blank" rel="noopener noreferrer"
          ><span class="eco-card-number">03 / Page</span><h3>把网站，<br />放到网上。</h3><p>
            连接仓库、构建、发布，拿到属于你的地址。
          </p><span class="eco-url">cxcs.page <ArrowUpRight size={17} /></span></a
        >
      </div>
    </div>
  </section>

  <section class="band theater-layout" id="theater">
    <div class="container">
      <div class="theater-intro">
        <SectionIntro
          eyebrow="07 / Theater"
          title="技术不一定非得一本正经。"
          description="我们也会把一些计算机知识，做成小剧场、漫画和一些奇怪的东西。"
        /><div class="speech">等等，计协还有这个。</div>
      </div>
      {
        latestEpisode && (
          <a class="episode-card" href={`/theater/${latestEpisode.id}`}>
            <>
              <div class="episode-cover">
                <img src={latestEpisode.data.cover.image} alt={latestEpisode.data.cover.alt} loading="lazy" />
              </div>
              <div class="episode-info">
                <>
                  <span class="episode-index">
                    LATEST EPISODE · EP.{String(latestEpisode.data.episode).padStart(2, '0')}
                  </span>
                  <h3>{latestEpisode.data.title}</h3>
                  <p>{latestEpisode.data.description}</p>
                  <span class="arrow-link">
                    开始阅读 <ArrowRight size={16} />
                  </span>
                  <div class="cast-row">
                    {latestEpisode.data.characters.map((id) => (
                      <span class="cast-pill">
                        <i class="cast-dot" />
                        {characters[id]?.name || id}
                      </span>
                    ))}
                  </div>
                </>
              </div>
            </>
          </a>
        )
      }
    </div>
  </section>

  <section class="join-band" id="join-us">
    <div class="container">
      <p class="eyebrow">08 / Join Us</p><h2>下一段故事，<br />等你一起写。</h2><p>
        不会编程没关系。有兴趣，就已经是一个很好的开始。
      </p><div class="hero-actions">
        <a class="button button-primary" href="/join">加入计算机协会 <ArrowRight size={16} /></a><a
          class="button button-secondary"
          href="/activities">先看看活动 <ArrowRight size={16} /></a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<script src="../scripts/home-motion.ts"></script>
