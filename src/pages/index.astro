---
import Button from '../components/Button.astro';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../config';
import StackScroll from '../widgets/StackScroll.astro';
import StackScrollCard from '../widgets/StackScrollCard.astro';
import { getArticleCategory, getArticleCover } from '../articles';

const { site: siteData, recruitment } = config;
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featuredArticle = articles.find((entry) => entry.data.featured) || articles[0];
const sideArticles = articles.filter((entry) => entry.id !== featuredArticle?.id).slice(0, 2);
---

<BaseLayout title={siteData.title} description={siteData.description}>
  <!-- Hero section matching design (full dvh, massive HELLO/WORLD, mascot parallax, kicker & index removed) -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="hero-stage">
      <div class="hero-title-lockup">
        <div class="hello" aria-hidden="true">
          HELLO
        </div>

        <div class="world" aria-hidden="true">
          WORLD.
        </div>
      </div>

      <img
        class="hero-character"
        src="/assets/characters/shurin-aran/hero.png"
        alt="Shurin Aran，计协娘"
        width="1024"
        height="1536"
        fetchpriority="high"
        data-hero-mascot
      />
    </div>

    <div class="hero-copy">
      <h1 id="hero-title">
        <span>欢迎来到</span>东南大学成贤学院
        <br />
        计算机协会
      </h1>
      <p>
        在纯粹的逻辑与无穷的构想之间，
        <br />
        用代码敲出真实世界的回响。
      </p>
    </div>

    <div class="hero-actions">
      <Button variant="primary" href="#what-we-do">
        看看我们在做什么 <ArrowRight size={14} />
      </Button>
      <Button variant="secondary" href="/join">
        加入计协 <ArrowUpRight size={14} />
      </Button>
    </div>

    <div class="hero-aside">
      代码赋予思想形状，
      <br />
      好奇赋予代码意义。
      <small>CODE GIVES FORM. CURIOSITY GIVES MEANING.</small>
    </div>
  </section>

  <!-- Section 02 / What We Do (Bento cards) -->
  <section class="section wrap" id="what-we-do" aria-labelledby="what-title">
    <div class="section-line">WHAT WE DO</div>
    <div class="section-heading">
      <h2 id="what-title">
        在课堂之外，
        <br />
        探索技术与创造的边界。
      </h2>
      <p>从底层原理的推敲，到面向现实的工程构筑。我们聚集于此，让抽象的构想落地生根，让未解的疑问找到答案。</p>
    </div>

    <div class="bento">
      <article class="daily">
        <div class="daily-top">
          <span>01 / LEARN</span>
          <span>探究本质</span>
        </div>
        <h3>理解原理，而非止于使用</h3>
        <p>
          从系统的底层运转，到现代应用的设计与工程。
          <br />
          我们不仅学习运用工具，更去理解其背后的逻辑与美感。
        </p>
        <span class="daily-symbol" aria-hidden="true">
          &lt;/&gt;
        </span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>02 / BUILD</span>
          <span>构建即是思考</span>
        </div>
        <h3>从无到有地构建</h3>
        <p>
          一个解决校园痛点的脚本、一个服务师生的平台，或是一场纯粹的技术实验。
          <br />
          只要敲下代码，想法便有了实体。
        </p>
        <span class="daily-symbol orange" aria-hidden="true">
          ↗
        </span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>03 / TEAM UP</span>
          <span>协作攻坚</span>
        </div>
        <h3>在竞技与协作中沉淀</h3>
        <p>
          在各类赛事与黑客松中并肩攻坚。
          <br />
          复杂的工程从不是孤胆英雄的舞台，团队协作让每一个难关都有所支撑。
        </p>
        <span class="daily-symbol" aria-hidden="true">
          &#123; &#125;
        </span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>04 / TOGETHER</span>
          <span>长久共鸣</span>
        </div>
        <h3>找到同频的探索者</h3>
        <p>
          工具与技术总在更迭，但那些
          <br />
          深夜并肩调试 Bug、因突破而击掌相庆的同伴，始终是大学里最珍贵的印记。
        </p>
        <span class="daily-symbol" aria-hidden="true">
          ++
        </span>
      </article>
    </div>
  </section>

  <!-- Section 03 / Start Here -->
  <section class="start" id="start-here" aria-labelledby="start-title">
    <div class="wrap">
      <div class="section-line">START HERE</div>
      <div class="start-intro">
        <p>“每一个庞大精密的系统，最初都来自一个空白的文件。”</p>
        <h2 id="start-title">
          不必先行万步，<span>从第一行开始。</span>
        </h2>
      </div>

      <div class="steps">
        <article class="step">
          <span class="step-number">01 →</span>
          <h3>从零开始</h3>
          <p>
            面对庞杂的技术栈，迷茫是常态。
            <br />
            我们梳理了踩坑经验与进阶路线，助你拨开迷雾，找到踏实的起点。
          </p>
          <a class="small-link" href={siteData.guideUrl} target="_blank" rel="noopener noreferrer">
            打开 CXCS Guide <ArrowUpRight size={13} />
          </a>
        </article>

        <article class="step">
          <span class="step-number">02 →</span>
          <h3>付诸工程</h3>
          <p>
            真正的理解发生在创造之中。
            <br />
            哪怕只是修改几个参数、解决一个小问题，亲自运行代码才是真正的领悟。
          </p>
          <a class="small-link" href="/articles">
            阅读探索与实践 <ArrowRight size={13} />
          </a>
        </article>

        <article class="step">
          <span class="step-number">03 ↗</span>
          <h3>把它分享出去</h3>
          <p>
            写完的代码，不应该只留在自己的电脑里。
            <br />
            把项目部署上线，让大家真正用上你的作品，新的交流也会随之发生。
          </p>
          <a class="small-link" href={siteData.pageUrl} target="_blank" rel="noopener noreferrer">
            用 CXCS Page 发布 <ArrowUpRight size={13} />
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Section 04 / Latest from CXCS -->
  <section class="section wrap" id="latest" aria-labelledby="latest-title">
    <div class="section-line">LATEST FROM CXCS</div>
    <div class="section-heading">
      <h2 id="latest-title">
        近期的记录、
        <br />
        思考与回声。
      </h2>
      <a class="small-link" href="/articles">
        全部文章 <ArrowRight size={14} />
      </a>
    </div>

    <div class="latest-grid">
      {featuredArticle && (
        <a class="lead-story" href={`/articles/${featuredArticle.id}`}>
          <img
            class="news-cover"
            src={getArticleCover(featuredArticle)}
            alt={featuredArticle.data.cover?.alt || featuredArticle.data.title}
            loading="lazy"
          />
          <div class="meta">
            <span class="type">{getArticleCategory(featuredArticle.data.type).label}</span>
            <span>·</span>
            <span>{featuredArticle.data.publishedAt.toLocaleDateString('zh-CN')}</span>
            {featuredArticle.data.authors.length > 0 && (
              <>
                <span>·</span>
                <span>{featuredArticle.data.authors.join(' / ')}</span>
              </>
            )}
          </div>
          <h3>{featuredArticle.data.title}</h3>
          <p>{featuredArticle.data.description}</p>
        </a>
      )}

      <div class="side-stories">
        {sideArticles.map((article) => (
          <a class="side-story" href={`/articles/${article.id}`}>
            <div>
              <div class="meta">
                <span class="type">{getArticleCategory(article.data.type).label}</span>
                <span>·</span>
                <span>{article.data.publishedAt.toLocaleDateString('zh-CN')}</span>
              </div>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </div>
            <img src={getArticleCover(article)} alt={article.data.cover?.alt || article.data.title} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 06 / Ecosystem -->
  <section class="ecosystem" id="ecosystem" aria-labelledby="ecosystem-title">
    <div class="wrap">
      <div class="section-line">CXCS ECOSYSTEM</div>
      <div class="section-heading">
        <h2 id="ecosystem-title">
          从初次探索，
          <br />
          到独立交付。
        </h2>
        <p>贯穿学习、实践与创造的完整过程。</p>
      </div>
    </div>

    <StackScroll>
      <StackScrollCard>
        <div class="wrap eco-panel eco-website">
          <div class="eco-content">
            <div class="eco-number">01 / MEET</div>
            <h3 class="eco-name">Website</h3>
            <h4 class="eco-headline">认识我们，也找到彼此。</h4>
            <p>记录协会的前沿动态、开源项目与成员轨迹。这里是对外开放的窗口，也是你与一群志同道合者相遇的起点。</p>
            <a class="small-link" href="#what">
              认识计算机协会 <ArrowRight size={14} />
            </a>
          </div>
          <div class="eco-visual">
            <img
              src="/assets/ecosystem/emblem.png"
              alt="东南大学成贤学院计算机协会完整社徽"
              width="226"
              height="226"
              loading="lazy"
            />
          </div>
        </div>
      </StackScrollCard>

      <StackScrollCard background="#2464ed" color="#ffffff" borderColor="#2464ed">
        <div class="wrap eco-panel eco-guide">
          <div class="eco-content">
            <div class="eco-number">02 / LEARN</div>
            <h3 class="eco-name">Guide</h3>
            <h4 class="eco-headline">前人踩过的坑，你的起点。</h4>
            <p>从开发环境配置到进阶技术路线。历届成员把踩过的坑和积累的经验整理成册，让你不必在迷茫中独自摸索。</p>
            <a class="small-link" href={siteData.guideUrl} target="_blank" rel="noopener noreferrer">
              前往 CXCS Guide <ArrowUpRight size={14} />
            </a>
          </div>
          <div class="eco-visual">
            <img
              src="/assets/ecosystem/guide-screen.png"
              alt="CXCS Guide 学习指南的真实网页界面"
              width="1440"
              height="1000"
              loading="lazy"
            />
          </div>
        </div>
      </StackScrollCard>

      <StackScrollCard background="#171b23" color="#ffffff" borderColor="#171b23">
        <div class="wrap eco-panel eco-page">
          <div class="eco-content">
            <div class="eco-number">03 / DEPLOY</div>
            <h3 class="eco-name">Page</h3>
            <h4 class="eco-headline">把项目交托上线，专注创造本身。</h4>
            <p>免去繁琐的服务器运维门槛。关联代码仓库即可自动完成构建，把更多时间留给写出真正有价值的代码。</p>
            <a class="small-link" href={siteData.pageUrl} target="_blank" rel="noopener noreferrer">
              前往 CXCS Page <ArrowUpRight size={14} />
            </a>
          </div>
          <div class="eco-visual">
            <img
              src="/assets/ecosystem/page-screen.png"
              alt="CXCS Page 网站的真实界面"
              width="1440"
              height="1000"
              loading="lazy"
            />
          </div>
        </div>
      </StackScrollCard>
    </StackScroll>
  </section>

  <!-- Section 07 / Join Us -->
  <section class="join-section" id="join-us" aria-labelledby="join-title">
    <div class="wrap">
      <div class="section-line">JOIN US</div>
      <div class="join-inner">
        <h2 id="join-title">
          下一段航程，
          <br />
          期待与你同行。
        </h2>
        <div>
          <p>
            技能可以从零研习，经验可以慢慢沉淀，但对探索的热望不可替代。
            <br />
            只要你对计算机的世界怀有好奇，这里便有属于你的一席之地。
          </p>
          <Button variant="primary" href="/join">
            加入计算机协会 <ArrowRight size={14} />
          </Button>
          <span class="join-status">
            {recruitment.title} · 公开 QQ 交流群 {recruitment.qqGroup}
          </span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let cleanupCurrentMotion: (() => void) | null = null;

  const initHomeMotion = () => {
    cleanupCurrentMotion?.();
    cleanupCurrentMotion = null;

    const hero = document.querySelector<HTMLElement>('.hero');
    const character = document.querySelector<HTMLElement>('.hero-character');
    if (!hero || !character) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let rafId: number | null = null;

    const updateLoop = () => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;

      character.style.setProperty('--px', `${currentX.toFixed(2)}px`);
      character.style.setProperty('--py', `${currentY.toFixed(2)}px`);

      if (Math.abs(targetX - currentX) > 0.05 || Math.abs(targetY - currentY) > 0.05) {
        rafId = requestAnimationFrame(updateLoop);
      } else {
        rafId = null;
      }
    };

    const startLoop = () => {
      if (rafId === null) rafId = requestAnimationFrame(updateLoop);
    };

    const onPointerMove = (event: PointerEvent) => {
      const bounds = hero.getBoundingClientRect();
      targetX = (event.clientX - bounds.left - bounds.width / 2) * 0.015;
      targetY = (event.clientY - bounds.top - bounds.height / 2) * 0.01;
      startLoop();
    };

    const onPointerLeave = () => {
      targetX = 0;
      targetY = 0;
      startLoop();
    };

    const onCharacterClick = () => {
      gsap.killTweensOf(character);
      gsap.fromTo(
        character,
        { '--character-click-scale': 0.94, '--character-click-rotate': '-1.2deg' },
        {
          '--character-click-scale': 1,
          '--character-click-rotate': '0deg',
          duration: 0.9,
          ease: 'elastic.out(1.2, 0.4)',
        },
      );
    };

    hero.addEventListener('pointermove', onPointerMove, { passive: true });
    hero.addEventListener('pointerleave', onPointerLeave, { passive: true });
    character.addEventListener('click', onCharacterClick);

    const context = gsap.context(() => {
      if (reduceMotion) return;

      gsap.from('.hello', {
        x: -30,
        opacity: 0,
        duration: 1.1,
        ease: 'power3.out',
      });

      gsap.from('.world', {
        x: 30,
        opacity: 0,
        duration: 1.1,
        delay: 0.1,
        ease: 'power3.out',
      });

      gsap.from(character, {
        opacity: 0,
        duration: 1.2,
        delay: 0.15,
        ease: 'power3.out',
      });

      gsap.from('.hero-copy, .hero-actions, .hero-aside', {
        y: 20,
        opacity: 0,
        duration: 0.9,
        delay: 0.35,
        stagger: 0.1,
        ease: 'power2.out',
      });

      const revealItems = document.querySelectorAll<HTMLElement>('.daily, .step, .side-story, .project-display');
      revealItems.forEach((item) => {
        gsap.from(item, {
          y: 28,
          opacity: 0,
          duration: 0.7,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: item,
            start: 'top 88%',
            toggleActions: 'play none none none',
          },
        });
      });
    });

    cleanupCurrentMotion = () => {
      hero.removeEventListener('pointermove', onPointerMove);
      hero.removeEventListener('pointerleave', onPointerLeave);
      character.removeEventListener('click', onCharacterClick);
      if (rafId !== null) cancelAnimationFrame(rafId);
      context.revert();
    };
  };

  document.addEventListener('astro:before-swap', () => cleanupCurrentMotion?.());
  document.addEventListener('astro:page-load', initHomeMotion);
  initHomeMotion();
</script>

<style>
  .hero {
    height: 100dvh;
    min-height: 100dvh;
    background: var(--ice);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--line);
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 120px 120px;
    opacity: 0.35;
    z-index: -1;
  }
  .hero-stage {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(1440px, calc(100% - clamp(30px, 7vw, 112px)));
    height: 100%;
    --character-center-y: 50%;
    --title-center-y: var(--character-center-y);
    --title-world-offset: 210px;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-title-lockup {
    position: absolute;
    inset-inline: 0;
    top: var(--title-center-y);
    height: calc(var(--title-world-offset) + 0.83em);
    margin-top: calc((var(--title-world-offset) + 0.83em) / -2);
    pointer-events: none;
    font-size: clamp(110px, 13vw, 197px);
    line-height: 0.83;
  }
  .hello,
  .world {
    position: absolute;
    font-weight: 800;
    line-height: 0.83;
    margin: 0;
    user-select: none;
  }
  .hello {
    font-size: clamp(120px, 14vw, 209px);
    left: 0;
    top: 0;
    color: var(--blue);
    z-index: 1;
  }
  .world {
    font-size: inherit;
    right: 0;
    top: var(--title-world-offset);
    color: var(--text);
    z-index: 3;
  }
  .hero-character {
    position: absolute;
    height: min(85dvh, 830px);
    width: auto;
    max-width: none;
    left: 50%;
    top: 50%;
    bottom: auto;
    z-index: 2;
    transform: translate3d(
        calc(-50% - var(--character-optical-shift, 38px) + var(--px, 0px)),
        calc(-50% + var(--py, 0px)),
        0
      )
      rotate(var(--character-click-rotate, 0deg)) scale(var(--character-click-scale, 1));
    filter: drop-shadow(0 18px 24px rgba(36, 100, 237, 0.1));
    transition: transform 0.1s ease-out;
    cursor: pointer;
    pointer-events: auto;
  }
  .hero-copy {
    position: absolute;
    left: clamp(20px, 4.5vw, 56px);
    bottom: clamp(96px, 12vh, 120px);
    z-index: 5;
    max-width: 400px;
  }
  .hero-copy h1 {
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.5;
    font-weight: 650;
    margin: 0 0 11px;
  }
  .hero-copy h1 span {
    display: block;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 5px;
    font-weight: 450;
  }
  .hero-copy p {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.85;
    margin: 0;
  }
  .hero-actions {
    position: absolute;
    left: clamp(20px, 4.5vw, 56px);
    bottom: clamp(28px, 4vh, 36px);
    display: flex;
    gap: 12px;
    z-index: 6;
  }
  .hero-aside {
    position: absolute;
    right: clamp(20px, 4.5vw, 56px);
    bottom: clamp(32px, 4.5vh, 42px);
    width: 220px;
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
    z-index: 5;
  }
  .hero-aside small {
    display: block;
    color: var(--muted);
    font-size: 9px;
    margin-top: 10px;
    letter-spacing: 0.05em;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 15px;
  }
  .daily {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 30px;
    min-height: 235px;
    position: relative;
    overflow: hidden;
    background: var(--surface);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .daily:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
  }
  .daily:nth-child(1),
  .daily:nth-child(4) {
    grid-column: span 7;
  }
  .daily:nth-child(2),
  .daily:nth-child(3) {
    grid-column: span 5;
  }
  .daily:nth-child(1) {
    background: var(--blue);
    color: #ffffff;
    border-color: var(--blue);
  }
  .daily:nth-child(4) {
    background: var(--ice);
  }
  .daily-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 38px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .daily:nth-child(1) .daily-top {
    color: #d9e6ff;
  }
  .daily h3 {
    font-size: 23px;
    font-weight: 600;
    margin: 0 0 9px;
    position: relative;
    z-index: 1;
  }
