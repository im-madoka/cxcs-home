---
import { ArrowRight, ArrowUpRight, Code2, Sparkles } from 'lucide-astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import BrandPlaceholder from '../components/BrandPlaceholder.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { siteData } from '../data/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featuredArticle = articles.find((entry) => entry.data.featured) || articles[0];
const latestArticles = articles.filter((entry) => entry.id !== featuredArticle?.id).slice(0, 2);
---

<BaseLayout title={siteData.title} description={siteData.description}>
  <section class="hero" id="top">
    <div class="container hero-inner">
      <div>
        <p class="hero-kicker">Computer Association · 2026</p>
        <h1>Hello,<br /><span class="accent">World.</span></h1>
        <p class="hero-copy cjk-copy">
          欢迎来到东南大学成贤学院计算机协会。<br />一起学习，一起折腾，一起做点有意思的东西。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#what-we-do">看看我们在做什么 <ArrowRight size={16} /></a>
          <a class="button button-secondary" href="/join">加入计协 <ArrowUpRight size={16} /></a>
        </div>
        <div class="scroll-cue"><span></span> Scroll to explore</div>
      </div>
      <div class="hero-visual" data-hero-visual>
        <!-- Floating organic decorative elements behind & around the mascot -->
        <div class="hero-decorations" aria-hidden="true">
          <div class="decor-aurora"></div>
          <div class="decor-ambient-light" data-decor-light></div>

          <!-- Smooth kinetic energy rings (fluid pulse & rotation) -->
          <div class="kinetic-orbit ring-outer"></div>
          <div class="kinetic-orbit ring-mid"></div>
          <div class="kinetic-orbit ring-inner"></div>

          <!-- Interactive particle constellations / code embers -->
          <div class="floating-mote mote-1"></div>
          <div class="floating-mote mote-2"></div>
          <div class="floating-mote mote-3"></div>
          <div class="floating-mote mote-4"></div>
        </div>

        <div class="hero-mascot-container" data-mascot-container>
          <img
            class="hero-mascot"
            src="/assets/characters/shurin-aran/hero.png"
            alt="Shurin Aran，计协娘"
            width="1024"
            height="1536"
            fetchpriority="high"
            data-hero-mascot
          />
        </div>

        <div class="mascot-tag" data-mascot-tag>
          <span class="tag-pulse" aria-hidden="true"></span>
          <span class="tag-name">Shurin Aran</span>
          <span class="tag-sep">·</span>
          <span class="tag-sub" style="-webkit-tap-highlight-color: transparent;">计协娘</span>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="what-we-do">
    <div class="container">
      <div class="section-head-row">
        <SectionIntro
          eyebrow="02 / What We Do"
          title="在计协，平时都在做什么？"
          titleLines={['在计协，', '平时都在做什么？']}
          description="聚在一起交流技术、动手做项目、组队打比赛，把感兴趣的想法亲手实现出来。"
        />
      </div>
      <div class="bento-grid">
        <article class="bento-card">
          <span class="card-number">01</span>
          <h3 class="cjk-heading">学习感兴趣的技术</h3>
          <p class="cjk-copy">从日常编程、Linux 到单片机折腾，只要你感兴趣，大家都可以一起交流探讨。</p>
          <div class="card-chips">
            <span class="chip">C / C++</span>
            <span class="chip">Python</span>
            <span class="chip">Web 前端</span>
            <span class="chip">Linux / Shell</span>
          </div>
          <span class="card-icon"><Code2 size={56} strokeWidth={1.3} /></span>
        </article>
        <article class="bento-card">
          <span class="card-number">02</span>
          <h3 class="cjk-heading">动手做点好玩的项目</h3>
          <p class="cjk-copy">写个实用小脚本、自动化社团 Bot，或是搭建个人主页，想到什么就动手做出来。</p>
          <div class="card-chips">
            <span class="chip">社团 Bot</span>
            <span class="chip">开源工具</span>
            <span class="chip">硬件折腾</span>
            <span class="chip">个人主页</span>
          </div>
          <span class="card-icon"><Sparkles size={56} strokeWidth={1.3} /></span>
        </article>
        <article class="bento-card">
          <span class="card-number">03</span>
          <h3 class="cjk-heading">组队参加学科竞赛</h3>
          <p class="cjk-copy">蓝桥杯、算法赛、黑客松……在这里能找到靠谱的队友和学长学姐的备赛经验，不再孤军奋战。</p>
          <div class="card-chips">
            <span class="chip">ACM / ICPC</span>
            <span class="chip">蓝桥杯</span>
            <span class="chip">计算机博弈大赛</span>
            <span class="chip">高校黑客松</span>
          </div>
          <span class="card-icon">↗</span>
        </article>
        <article class="bento-card">
          <span class="card-number">04</span>
          <h3 class="cjk-heading">结识一群爱折腾的朋友</h3>
          <p class="cjk-copy">写代码不用一个人对着屏幕死磕，社团里有一群同样热爱钻研软硬件的同好，随时交流答疑。</p>
          <div class="card-chips">
            <span class="chip">代码交流</span>
            <span class="chip">经验传承</span>
            <span class="chip">线下活动</span>
            <span class="chip">技术沙龙</span>
          </div>
          <span class="card-icon">⌁</span>
        </article>
      </div>
    </div>
  </section>

  <section class="band band-soft" id="start-here">
    <div class="container">
      <div class="section-head-row">
        <SectionIntro
          eyebrow="03 / Start Here"
          title="零基础？完全不用担心"
          titleLines={['零基础？', '完全不用担心。']}
          description="大家都是从配置环境、敲出第一行代码开始的。顺着路线慢慢来，很快就能上手。"
        />
      </div>
      <div class="journey">
        <article class="journey-step">
          <div class="journey-no"><span>01</span><span>Learn</span></div><h3 class="cjk-heading">新手起步</h3><p
            class="cjk-copy"
          >
            第一次接触编程？不用慌。我们整理了适合新生的自学指引和避坑经验。
          </p><ArrowLink href={siteData.guideUrl} label="查阅 CXCS Guide" external />
        </article>
        <article class="journey-step">
          <div class="journey-no"><span>02</span><span>Build</span></div><h3 class="cjk-heading">动手实践</h3><p
            class="cjk-copy"
          >
            光看书不够过瘾，跟着大家一起写个小功能、搭个小页面，在实践中真正理解代码。
          </p>
        </article>
        <article class="journey-step">
          <div class="journey-no"><span>03</span><span>Deploy</span></div><h3 class="cjk-heading">上线展示</h3><p
            class="cjk-copy"
          >
            写好的个人主页或小作品，可以直接用协会提供的托管平台上线，分享给身边的朋友。
          </p><ArrowLink href={siteData.pageUrl} label="了解 CXCS Page" external />
        </article>
      </div>
    </div>
  </section>

  <section class="band" id="latest">
    <div class="container">
      <div class="section-head-row">
        <SectionIntro
          eyebrow="04 / Latest"
          title="近期动态与分享"
          titleLines={['近期动态与分享']}
          description="协会成员的技术文章、活动记录与最新消息。"
        /><ArrowLink href="/articles" label="浏览全部文章" />
      </div>
      {
        featuredArticle && (
          <div class="featured-layout">
            <a class="story-card" href={`/articles/${featuredArticle.id}`}>
              {featuredArticle.data.cover ? (
                <img src={featuredArticle.data.cover.image} alt={featuredArticle.data.cover.alt} loading="lazy" />
              ) : (
                <BrandPlaceholder label="LATEST" />
              )}
              <div class="story-content">
                <>
                  <div class="eyebrow">
                    {featuredArticle.data.type} · {featuredArticle.data.publishedAt.toLocaleDateString('zh-CN')}
                  </div>
                  <h3 class="cjk-heading">{featuredArticle.data.title}</h3>
                  <p class="cjk-copy">{featuredArticle.data.description}</p>
                  <span class="arrow-link">
                    阅读更多 <ArrowRight size={16} />
                  </span>
                </>
              </div>
            </a>
            <div class="story-side">
              {latestArticles.map((article) => (
                <a class="mini-story" href={`/articles/${article.id}`}>
                  <div class="article-cover">
                    {article.data.cover ? (
                      <img src={article.data.cover.image} alt={article.data.cover.alt} loading="lazy" />
                    ) : (
                      <BrandPlaceholder label={article.data.type.toUpperCase()} />
                    )}
                  </div>
                  <div>
                    <div class="article-meta">
                      <span class="article-type">{article.data.type}</span>
                      <span>{article.data.publishedAt.toLocaleDateString('zh-CN')}</span>
                    </div>
                    <h3 class="cjk-heading">{article.data.title}</h3>
                    <p class="cjk-copy">{article.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="band ecosystem" id="ecosystem">
    <div class="container">
      <SectionIntro
        eyebrow="05 / CXCS Ecosystem"
        title="我们自己的数字空间"
        titleLines={['我们自己的数字空间']}
        description="除了日常社团交流，我们也在搭建属于协会自己的工具与平台。"
      />
      <div class="ecosystem-grid">
        <a class="eco-card" href="/about"
          ><span class="eco-card-number">01 / Website</span><h3 class="cjk-heading">社团主站</h3><p class="cjk-copy">
            了解协会简介、日常活动、项目作品与招新安排。
          </p><span class="eco-url">cxcs.dev <ArrowRight size={17} /></span></a
        >
        <a class="eco-card" href={siteData.guideUrl} target="_blank" rel="noopener noreferrer"
          ><span class="eco-card-number">02 / Guide</span><h3 class="cjk-heading">新生知识库</h3><p class="cjk-copy">
            面向零基础同学整理的编程入门教程与避坑指南。
          </p><span class="eco-url">guide.cxcs.dev <ArrowUpRight size={17} /></span></a
        >
        <a class="eco-card" href={siteData.pageUrl} target="_blank" rel="noopener noreferrer"
          ><span class="eco-card-number">03 / Page</span><h3 class="cjk-heading">成员主页托管</h3><p class="cjk-copy">
            专为协会成员打造的静态托管服务，连接 Git 仓库即可一键上线网站。
          </p><span class="eco-url">cxcs.page <ArrowUpRight size={17} /></span></a
        >
      </div>
    </div>
  </section>

  <section class="join-band" id="join-us">
    <div class="container">
      <p class="eyebrow">06 / Join Us</p><h2 class="cjk-heading">下一段故事，<br />等你一起写。</h2><p class="cjk-copy">
        不会写代码完全没关系。<br class="mobile-only-break" />只要你对计算机抱有好奇心，随时欢迎来聊聊。
      </p><div class="hero-actions">
        <a class="button button-primary" href="/join">加入计算机协会 <ArrowRight size={16} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script src="../scripts/home-motion.ts"></script>
