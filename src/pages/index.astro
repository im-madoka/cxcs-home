---
import { ArrowRight, ArrowUpRight } from 'lucide-astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../config';
import StackScroll from '../widgets/StackScroll.astro';
import { getArticleCategory, getArticleCover } from '../articles';

const { site: siteData, recruitment } = config;
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featuredArticle = articles.find((entry) => entry.data.featured) || articles[0];
const sideArticles = articles.filter((entry) => entry.id !== featuredArticle?.id).slice(0, 2);
---

<BaseLayout title={siteData.title} description={siteData.description}>
  <!-- Hero section matching design (full dvh, massive HELLO/WORLD, mascot parallax, kicker & index removed) -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="hero-stage">
      <div class="hero-title-lockup">
        <div class="hello" aria-hidden="true">HELLO</div>

        <div class="world" aria-hidden="true">WORLD.</div>
      </div>

      <img
        class="hero-character"
        src="/assets/characters/shurin-aran/hero.png"
        alt="Shurin Aran，计协娘"
        width="1024"
        height="1536"
        fetchpriority="high"
        data-hero-mascot
      />
    </div>

    <div class="hero-copy">
      <h1 id="hero-title">
        <span>欢迎来到</span>东南大学成贤学院<br />计算机协会
      </h1>
      <p>
        一起学习，一起折腾，<br />一起做点有意思的东西。
      </p>
    </div>

    <div class="hero-actions">
      <a class="button button-primary" href="#what-we-do">
        看看我们在做什么 <ArrowRight size={14} />
      </a>
      <a class="button button-secondary" href="/join">
        加入计协 <ArrowUpRight size={14} />
      </a>
    </div>

    <div class="hero-aside">
      不必先成为高手。<br />从“有点好奇”开始，就很好。
      <small>LEARN. BUILD. DEPLOY. SHARE.</small>
    </div>
  </section>

  <!-- Section 02 / What We Do (Bento cards) -->
  <section class="section wrap" id="what-we-do" aria-labelledby="what-title">
    <div class="section-line"><span>02</span> WHAT WE DO</div>
    <div class="section-heading">
      <h2 id="what-title">所以，我们平时<br />到底在干嘛？</h2>
      <p>这里有代码、有项目，也有很多还没想明白的问题。大家一起，让想法往前走一点。</p>
    </div>

    <div class="bento">
      <article class="daily">
        <div class="daily-top">
          <span>01 / LEARN</span>
          <span>从好奇出发</span>
        </div>
        <h3>学点新东西</h3>
        <p>编程、电脑、软件、开发板……<br />感兴趣的东西，都可以一起研究。</p>
        <span class="daily-symbol" aria-hidden="true">&lt;/&gt;</span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>02 / BUILD</span>
          <span>动手比空想有趣</span>
        </div>
        <h3>做点有意思的项目</h3>
        <p>网站、小游戏、机器人、小工具。<br />想到了，就试着把它做出来。</p>
        <span class="daily-symbol orange" aria-hidden="true">↗</span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>03 / TEAM UP</span>
          <span>一起想办法</span>
        </div>
        <h3>一起参加比赛</h3>
        <p>有队友、有经验分享，<br />也有人陪你一起踩坑。</p>
        <span class="daily-symbol" aria-hidden="true">&#123; &#125;</span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>04 / TOGETHER</span>
          <span>找到你的同伴</span>
        </div>
        <h3>认识一群爱折腾的人</h3>
        <p>技术很重要，但找到一群<br />志同道合的人也很重要。</p>
        <span class="daily-symbol" aria-hidden="true">++</span>
      </article>
    </div>
  </section>

  <!-- Section 03 / Start Here -->
  <section class="start" id="start-here" aria-labelledby="start-title">
    <div class="wrap">
      <div class="section-line"><span>03</span> START HERE</div>
      <div class="start-intro">
        <p>“可是……我什么都不会。”</p>
        <h2 id="start-title">那就，<span>从零开始。</span></h2>
      </div>

      <div class="steps">
        <article class="step">
          <span class="step-number">01 →</span>
          <h3>从零开始</h3>
          <p>第一次写代码？没关系。<br />先找到一条适合自己的学习路线。</p>
          <a class="small-link" href={siteData.guideUrl} target="_blank" rel="noopener noreferrer">
            打开 CXCS Guide <ArrowUpRight size={13} />
          </a>
        </article>

        <article class="step">
          <span class="step-number">02 →</span>
          <h3>做点自己的东西</h3>
          <p>学会一点，就用起来。<br />把一个想法变成看得见的小项目。</p>
          <a class="small-link" href="#projects">
            看看我们的项目 <ArrowRight size={13} />
          </a>
        </article>

        <article class="step">
          <span class="step-number">03 ↗</span>
          <h3>把它分享出去</h3>
          <p>给做好的网站一个地址。<br />让作品被打开，也让新的交流发生。</p>
          <a class="small-link" href={siteData.pageUrl} target="_blank" rel="noopener noreferrer">
            用 CXCS Page 发布 <ArrowUpRight size={13} />
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Section 04 / Latest from CXCS -->
  <section class="section wrap" id="latest" aria-labelledby="latest-title">
    <div class="section-line"><span>04</span> LATEST FROM CXCS</div>
    <div class="section-heading">
      <h2 id="latest-title">我们最近，<br />又折腾了些什么。</h2>
      <a class="small-link" href="/articles">全部文章 <ArrowRight size={14} /></a>
    </div>

    <div class="latest-grid">
      {
        featuredArticle && (
          <a class="lead-story" href={`/articles/${featuredArticle.id}`}>
            <img
              class="news-cover"
              src={getArticleCover(featuredArticle)}
              alt={featuredArticle.data.cover?.alt || featuredArticle.data.title}
              loading="lazy"
            />
            <div class="meta">
              <span class="type">{getArticleCategory(featuredArticle.data.type).label}</span>
              <span>·</span>
              <span>{featuredArticle.data.publishedAt.toLocaleDateString('zh-CN')}</span>
              {featuredArticle.data.authors.length > 0 && (
                <>
                  <span>·</span>
                  <span>{featuredArticle.data.authors.join(' / ')}</span>
                </>
              )}
            </div>
            <h3>{featuredArticle.data.title}</h3>
            <p>{featuredArticle.data.description}</p>
          </a>
        )
      }

      <div class="side-stories">
        {
          sideArticles.map((article) => (
            <a class="side-story" href={`/articles/${article.id}`}>
              <div>
                <div class="meta">
                  <span class="type">{getArticleCategory(article.data.type).label}</span>
                  <span>·</span>
                  <span>{article.data.publishedAt.toLocaleDateString('zh-CN')}</span>
                </div>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </div>
              <img src={getArticleCover(article)} alt={article.data.cover?.alt || article.data.title} loading="lazy" />
            </a>
          ))
        }

        <div class="latest-note">
          <span>*</span>
          <span>所有文章均由协会成员撰写与维护。</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 05 / Projects (CXCS Page showcase) -->
  <section class="projects" id="projects" aria-labelledby="project-title">
    <div class="wrap">
      <div class="section-line"><span>05</span> PROJECTS</div>
      <div class="section-heading project-heading">
        <h2 id="project-title">我们真的会<br />做点东西。</h2>
        <p>先解决一个身边的小问题，<br />再把它变成大家都用得上的工具。</p>
      </div>

      <a
        class="project-display"
        href={siteData.pageUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="访问 CXCS Page"
      >
        <img
          src="/assets/ecosystem/page-screen.png"
          alt="CXCS Page 网站的真实界面"
          width="1440"
          height="1000"
          loading="lazy"
        />
      </a>

      <div class="project-description">
        <div>
          <div class="project-title">
            <h3>CXCS Page</h3>
            <span>FEATURED</span>
          </div>
          <p>你负责把网站做好，我们帮它被看见。连接代码仓库，完成构建，就能拿到一个真正可以访问的网址。</p>
          <a class="small-link" href={siteData.pageUrl} target="_blank" rel="noopener noreferrer">
            发布你的网站 <ArrowUpRight size={13} />
          </a>
        </div>
        <div class="deploy-flow" aria-label="网站发布流程">
          <span><b>01</b>获取项目代码</span>
          <span><b>02</b>安装项目依赖</span>
          <span><b>03</b>构建完成</span>
          <span><b>04</b>网站已经上线 ↗</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 06 / Ecosystem Stacking Scroll Component -->
  <StackScroll />

  <!-- Section 07 / Join Us -->
  <section class="join-section" id="join-us" aria-labelledby="join-title">
    <div class="wrap">
      <div class="section-line"><span>07</span> JOIN US</div>
      <div class="join-inner">
        <h2 id="join-title">下一段故事，<br />等你一起写。</h2>
        <div>
          <p>
            不会编程没关系。<br />有兴趣，就已经是很好的开始。
          </p>
          <a class="button button-primary" href="/join">
            来一起做点有意思的事 <ArrowRight size={14} />
          </a>
          <span class="join-status">
            {recruitment.title} · 公开 QQ 交流群 {recruitment.qqGroup}
          </span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script src="../assets/scripts/home-motion.ts"></script>
