---
import Button from '../components/Button.astro';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../config';
import StackScroll from '../widgets/StackScroll.astro';
import StackScrollCard from '../widgets/StackScrollCard.astro';
import HomeGallery from '../widgets/HomeGallery.astro';

import { getArticleCategory, getArticleCover } from '../articles';

const { site: siteData, recruitment } = config;
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featuredArticle = articles.find((entry) => entry.data.featured) || articles[0];
const sideArticles = articles.filter((entry) => entry.id !== featuredArticle?.id).slice(0, 2);
---

<BaseLayout>
  <!-- Hero section matching design (full dvh, massive HELLO/WORLD, mascot parallax, kicker & index removed) -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="hero-stage">
      <div class="hero-title-lockup">
        <div class="hello" aria-hidden="true">HELLO</div>

        <div class="world" aria-hidden="true">WORLD.</div>
      </div>

      <img
        class="hero-character"
        src="/assets/characters/shurin-aran/hero.png"
        alt="Shurin Aran，计协娘"
        width="1024"
        height="1536"
        fetchpriority="high"
        data-hero-mascot
      />
    </div>

    <div class="hero-copy">
      <h1 id="hero-title">
        <span>欢迎来到</span>东南大学成贤学院
        <br />
        计算机协会
      </h1>
      <p>
        在纯粹的逻辑与无穷的构想之间，
        <br />
        用代码敲出真实世界的回响。
      </p>
    </div>

    <div class="hero-actions">
      <Button variant="primary" href="#what-we-do">
        看看我们在做什么 <ArrowRight size={14} />
      </Button>
      <Button variant="secondary" href="/join">
        加入计协 <ArrowUpRight size={14} />
      </Button>
    </div>

    <div class="hero-aside">
      代码赋予思想形状，
      <br />
      好奇赋予代码意义。
      <small>CODE GIVES FORM. CURIOSITY GIVES MEANING.</small>
    </div>
  </section>

  <!-- Section 02 / What We Do (Bento cards) -->
  <section class="section wrap" id="what-we-do" aria-labelledby="what-title">
    <div class="section-line">WHAT WE DO</div>
    <div class="section-heading section-heading-stacked">
      <h2 id="what-title">
        在课堂之外，
        <br />
        探索技术与创造的边界。
      </h2>
      <p>从底层原理的推敲，到面向现实的工程构筑。我们聚集于此，让抽象的构想落地生根，让未解的疑问找到答案。</p>
    </div>

    <div class="bento">
      <article class="daily">
        <div class="daily-top">
          <span>01 / LEARN</span>
          <span>探究本质</span>
        </div>
        <h3>理解原理，而非止于使用</h3>
        <p>
          从系统的底层运转，到现代应用的设计与工程。
          <br />
          我们不仅学习运用工具，更去理解其背后的逻辑与美感。
        </p>
        <span class="daily-symbol" aria-hidden="true"> &lt;/&gt; </span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>02 / BUILD</span>
          <span>构建即是思考</span>
        </div>
        <h3>从无到有地构建</h3>
        <p>
          一个解决校园痛点的脚本、一个服务师生的平台，或是一场纯粹的技术实验。
          <br />
          只要敲下代码，想法便有了实体。
        </p>
        <span class="daily-symbol orange" aria-hidden="true"> ↗ </span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>03 / TEAM UP</span>
          <span>协作攻坚</span>
        </div>
        <h3>在竞技与协作中沉淀</h3>
        <p>
          在各类赛事与黑客松中并肩攻坚。
          <br />
          复杂的工程从不是孤胆英雄的舞台，团队协作让每一个难关都有所支撑。
        </p>
        <span class="daily-symbol" aria-hidden="true"> &#123; &#125; </span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>04 / TOGETHER</span>
          <span>长久共鸣</span>
        </div>
        <h3>找到同频的探索者</h3>
        <p>
          工具与技术总在更迭，但那些
          <br />
          深夜并肩调试 Bug、因突破而击掌相庆的同伴，始终是大学里最珍贵的印记。
        </p>
        <span class="daily-symbol" aria-hidden="true"> ++ </span>
      </article>
    </div>
  </section>

  <!-- Section 03 / Start Here -->
  <section class="start" id="start-here" aria-labelledby="start-title">
    <div class="wrap">
      <div class="section-line">START HERE</div>
      <div class="start-intro">
        <p>“每一个庞大精密的系统，最初都来自一个空白的文件。”</p>
        <h2 id="start-title">
          不必先行万步，<span>从第一行开始。</span>
        </h2>
      </div>

      <div class="steps">
        <article class="step">
          <span class="step-number">01 →</span>
          <h3>从零开始</h3>
          <p>
            面对庞杂的技术栈，迷茫是常态。
            <br />
            我们梳理了踩坑经验与进阶路线，助你拨开迷雾，找到踏实的起点。
          </p>
          <a class="small-link" href={siteData.guideUrl} target="_blank" rel="noopener noreferrer">
            打开 CXCS Guide <ArrowUpRight size={13} />
          </a>
        </article>

        <article class="step">
          <span class="step-number">02 →</span>
          <h3>付诸工程</h3>
          <p>
            真正的理解发生在创造之中。
            <br />
            哪怕只是修改几个参数、解决一个小问题，亲自运行代码才是真正的领悟。
          </p>
          <a class="small-link" href="/articles">
            阅读探索与实践 <ArrowRight size={13} />
          </a>
        </article>

        <article class="step">
          <span class="step-number">03 ↗</span>
          <h3>把它分享出去</h3>
          <p>
            写完的代码，不应该只留在自己的电脑里。
            <br />
            把项目部署上线，让大家真正用上你的作品，新的交流也会随之发生。
          </p>
          <a class="small-link" href={siteData.pageUrl} target="_blank" rel="noopener noreferrer">
            用 CXCS Page 发布 <ArrowUpRight size={13} />
          </a>
        </article>
      </div>
    </div>
  </section>

  <HomeGallery />

  <!-- Section 05 / Latest from CXCS -->
  <section class="section wrap" id="latest" aria-labelledby="latest-title">
    <div class="section-line">LATEST FROM CXCS</div>
    <div class="section-heading">
      <h2 id="latest-title">
        近期的记录、
        <br />
        思考与回声。
      </h2>
      <a class="small-link" href="/articles">
        全部文章 <ArrowRight size={14} />
      </a>
    </div>

    <div class="latest-grid">
      {
        featuredArticle && (
          <a class="lead-story" href={`/articles/${featuredArticle.id}`}>
            <img
              class="news-cover"
              src={getArticleCover(featuredArticle)}
              alt={featuredArticle.data.cover?.alt || featuredArticle.data.title}
              loading="lazy"
            />
            <div class="meta">
              <span class="type">{getArticleCategory(featuredArticle.data.type).label}</span>
              <span>·</span>
              <span>{featuredArticle.data.publishedAt.toLocaleDateString('zh-CN')}</span>
              {featuredArticle.data.authors.length > 0 && (
                <>
                  <span>·</span>
                  <span>{featuredArticle.data.authors.join(' / ')}</span>
                </>
              )}
            </div>
            <h3>{featuredArticle.data.title}</h3>
            <p>{featuredArticle.data.description}</p>
          </a>
        )
      }

      <div class="side-stories">
        {
          sideArticles.map((article) => (
            <a class="side-story" href={`/articles/${article.id}`}>
              <div>
                <div class="meta">
                  <span class="type">{getArticleCategory(article.data.type).label}</span>
                  <span>·</span>
                  <span>{article.data.publishedAt.toLocaleDateString('zh-CN')}</span>
                </div>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </div>
              <img src={getArticleCover(article)} alt={article.data.cover?.alt || article.data.title} loading="lazy" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 06 / The Journey -->
  <section class="ecosystem" id="journey" aria-labelledby="journey-title">
    <div class="wrap">
      <div class="section-line">THE JOURNEY</div>
      <div class="section-heading section-heading-stacked">
        <h2 id="journey-title">
          从初次探索，
          <br />
          到独当一面。
        </h2>
        <p>在计协，见证每一个纯粹想法生根发芽、化为现实的成长历程。</p>
      </div>
    </div>

    <StackScroll>
      <StackScrollCard>
        <div class="wrap eco-panel eco-journey-begin">
          <div class="eco-content">
            <div class="eco-number">01 / BEGIN</div>
            <h3 class="eco-name">Spark</h3>
            <h4 class="eco-headline">从第一行代码，到拨开迷雾。</h4>
            <p>
              面对陌生的终端、繁杂的配置与未知的报错，迷茫是必经的开端。
              历届成员踩坑沉淀的新人指南，加上学长学姐在身边的即时答疑指引，让你不必独自在黑暗中摸索。迈出第一步，走得踏实而清醒。
            </p>
            <a class="small-link" href={siteData.guideUrl} target="_blank" rel="noopener noreferrer">
              查阅学习指南 CXCS Guide <ArrowUpRight size={14} />
            </a>
          </div>
          <div class="eco-visual">
            <div class="journey-mockup terminal-mockup">
              <div class="mockup-header">
                <div class="mockup-dots">
                  <span class="dot dot-red"></span>
                  <span class="dot dot-yellow"></span>
                  <span class="dot dot-green"></span>
                </div>
                <span class="mockup-title">zsh — ~/cxcs-workspace</span>
              </div>
              <div class="mockup-body code-font">
                <div class="term-line prompt">
                  <span class="prompt-arrow">➜</span>
                  <span class="prompt-path">~</span>
                  <span class="prompt-cmd">cxcs init student-journey</span>
                </div>
                <div class="term-line success">✓ 正在载入成贤计协历代学习路线...</div>
                <div class="term-line success">✓ 基础开发环境配置就绪 (Linux / Git / Web)</div>
                <div class="term-line success">✓ 专属学长/学姐答疑通道已接入</div>
                <div class="term-line prompt" style="margin-top: 14px;">
                  <span class="prompt-arrow">➜</span>
                  <span class="prompt-path">student-journey</span>
                  <span class="prompt-cmd">echo "Hello, CXCS!"</span>
                </div>
                <div class="term-output">"在纯粹的逻辑与无穷的构想之间，敲出真实世界的回响。"</div>
                <div class="term-cursor-line">
                  <span class="prompt-arrow">➜</span>
                  <span class="prompt-path">student-journey</span>
                  <span class="cursor">_</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </StackScrollCard>

      <StackScrollCard background="#2464ed" color="#ffffff" borderColor="#2464ed">
        <div class="wrap eco-panel eco-journey-forge">
          <div class="eco-content">
            <div class="eco-number">02 / FORGE</div>
            <h3 class="eco-name">Build</h3>
            <h4 class="eco-headline">在并肩攻坚中，把想法打磨成工程。</h4>
            <p>
              真正深刻的蜕变，发生在深夜与同伴连麦排查 Bug 的时刻。
              从个人的练手脚本，到团队协作的真实系统与竞赛答辩。Git
              协作分支、严谨的代码评审与架构推演——复杂的工程不再是单打独斗，一群同频的人让每个难关都有所支撑。
            </p>
            <a class="small-link" href="/articles">
              阅读社员实践与博客 <ArrowRight size={14} />
            </a>
          </div>
          <div class="eco-visual">
            <div class="journey-mockup pr-mockup">
              <div class="pr-top-bar">
                <span class="pr-badge">✓ Merged</span>
                <span class="pr-repo">cxcs / campus-services</span>
                <span class="pr-id">#42</span>
              </div>
              <div class="pr-title">feat: 校园空教室检索与课表高速缓存链路</div>
              <div class="pr-meta-row">
                <span class="pr-author">3 authors</span>
                <span class="pr-dot">·</span>
                <span class="pr-status">All 12 checks passed</span>
              </div>
              <div class="pr-timeline">
                <div class="timeline-item">
                  <span class="tl-icon commit">●</span>
                  <div class="tl-content">
                    <span class="tl-msg">fix: 重构并发锁，消除并发请求脏读</span>
                    <span class="tl-hash">commit 8a2f1c</span>
                  </div>
                </div>
                <div class="timeline-item">
                  <span class="tl-icon review">✓</span>
                  <div class="tl-content">
                    <span class="tl-msg">Review approved by mentors</span>
                    <span class="tl-sub">“架构逻辑清晰，缓存驱逐策略处理得很稳！”</span>
                  </div>
                </div>
              </div>
              <div class="pr-stats-row">
                <span class="stat-tag">+384 lines</span>
                <span class="stat-tag">-96 lines</span>
                <span class="stat-tag">CI: 48s passed</span>
              </div>
            </div>
          </div>
        </div>
      </StackScrollCard>

      <StackScrollCard background="#171b23" color="#ffffff" borderColor="#171b23">
        <div class="wrap eco-panel eco-journey-play">
          <div class="eco-content">
            <div class="eco-number">03 / PLAY</div>
            <h3 class="eco-name">Create</h3>
            <h4 class="eco-headline">别管实不实用，好玩就值得折腾。</h4>
            <p>
              不用一开始就奔着什么严肃的大工程去。 在群里写个定时播报的整活 Bot、用 Rust 随手搓个极速 Web
              工具，或者组装一块墨水屏开发板……只要你觉得有意思，协会就有人陪你一起折腾。大学里最难得的，就是有时间和同伴做点纯粹好玩的东西。
            </p>
            <a class="small-link" href="/articles">
              看看大家都在折腾什么 <ArrowRight size={14} />
            </a>
          </div>
          <div class="eco-visual">
            <div class="journey-mockup tinker-mockup">
              <div class="tinker-header">
                <span class="tinker-label">EXPERIMENT LAB</span>
                <span class="tinker-subtitle">纯粹出于好玩折腾出的小玩意</span>
              </div>
              <div class="tinker-list">
                <div class="tinker-item">
                  <span class="tinker-emoji">🤖</span>
                  <div class="tinker-body">
                    <div class="tinker-row">
                      <span class="tinker-title">社群助手 & 整活 Bot</span>
                      <span class="tinker-tag">TypeScript</span>
                    </div>
                    <p class="tinker-desc">早八唤醒、GitHub 热榜推送与自定义梗图生成，每天在群里陪大家打发时间。</p>
                  </div>
                </div>
                <div class="tinker-item">
                  <span class="tinker-emoji">🦀</span>
                  <div class="tinker-body">
                    <div class="tinker-row">
                      <span class="tinker-title">局域网快传与极速工具站</span>
                      <span class="tinker-tag">Rust</span>
                    </div>
                    <p class="tinker-desc">基于 Axum 构建的轻量 Web 服务，几乎不吃内存，宿舍内网大文件秒级直传。</p>
                  </div>
                </div>
                <div class="tinker-item">
                  <span class="tinker-emoji">🕹️</span>
                  <div class="tinker-body">
                    <div class="tinker-row">
                      <span class="tinker-title">墨水屏开发板桌面挂件</span>
                      <span class="tinker-tag">单片机</span>
                    </div>
                    <p class="tinker-desc">闲置电子墨水屏改造成天气日历时钟，低功耗常亮，偶尔还能刷一把贪吃蛇。</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </StackScrollCard>
    </StackScroll>
  </section>

  <!-- Section 07 / Join Us -->
  <section class="join-section" id="join-us" aria-labelledby="join-title">
    <div class="wrap">
      <div class="section-line">JOIN US</div>
      <div class="join-inner">
        <h2 id="join-title">
          下一段航程，
          <br />
          期待与你同行。
        </h2>
        <div>
          <p>
            技能可以从零研习，经验可以慢慢沉淀，但对探索的热望不可替代。
            <br />
            只要你对计算机的世界怀有好奇，这里便有属于你的一席之地。
          </p>
          <Button variant="primary" href="/join">
            加入计算机协会 <ArrowRight size={14} />
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initHeroMotion } from '../assets/scripts/hero-motion';

  gsap.registerPlugin(ScrollTrigger);

  let cleanupCurrentMotion: (() => void) | null = null;

  const initHomeMotion = () => {
    cleanupCurrentMotion?.();
    cleanupCurrentMotion = null;

    const hero = document.querySelector<HTMLElement>('.hero');
    const character = document.querySelector<HTMLElement>('.hero-character');
    if (!hero || !character) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cleanupHeroMotion = initHeroMotion(hero, character);

    const onCharacterClick = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      gsap.killTweensOf(character);
      gsap.fromTo(
        character,
        { '--character-click-scale': 0.94, '--character-click-rotate': '-1.2deg' },
        {
          '--character-click-scale': 1,
          '--character-click-rotate': '0deg',
          duration: 0.9,
          ease: 'elastic.out(1.2, 0.4)',
        },
      );
    };

    character.addEventListener('click', onCharacterClick);

    const context = gsap.context(() => {
      if (reduceMotion) return;

      gsap.from('.hello', {
        x: -30,
        opacity: 0,
        duration: 1.1,
        ease: 'power3.out',
      });

      gsap.from('.world', {
        x: 30,
        opacity: 0,
        duration: 1.1,
        delay: 0.1,
        ease: 'power3.out',
      });

      gsap.from(character, {
        opacity: 0,
        duration: 1.2,
        delay: 0.15,
        ease: 'power3.out',
      });

      gsap.from('.hero-copy, .hero-actions, .hero-aside', {
        y: 20,
        opacity: 0,
        duration: 0.9,
        delay: 0.35,
        stagger: 0.1,
        ease: 'power2.out',
      });

      const revealItems = document.querySelectorAll<HTMLElement>('.daily, .step, .side-story, .project-display');
      revealItems.forEach((item) => {
        gsap.from(item, {
          y: 28,
          opacity: 0,
          duration: 0.7,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: item,
            start: 'top 88%',
            toggleActions: 'play none none none',
          },
        });
      });
    });

    cleanupCurrentMotion = () => {
      cleanupHeroMotion();
      character.removeEventListener('click', onCharacterClick);
      gsap.killTweensOf(character);
      context.revert();
    };
  };

  document.addEventListener('astro:before-swap', () => cleanupCurrentMotion?.());
  document.addEventListener('astro:page-load', initHomeMotion);
  initHomeMotion();
</script>

<style>
  .hero {
    height: 100vh;
    min-height: 100vh;
    background: var(--ice);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--line);
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 120px 120px;
    opacity: 0.35;
    z-index: -1;
  }
  .hero-stage {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(1440px, calc(100% - clamp(30px, 7vw, 112px)));
    height: 100%;
    --character-center-y: 50%;
    --title-center-y: var(--character-center-y);
    --title-world-offset: 210px;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-title-lockup {
    position: absolute;
    inset-inline: 0;
    top: var(--title-center-y);
    height: calc(var(--title-world-offset) + 0.83em);
    margin-top: calc((var(--title-world-offset) + 0.83em) / -2);
    pointer-events: none;
    font-size: clamp(110px, 13vw, 197px);
    line-height: 0.83;
  }
  .hello,
  .world {
    position: absolute;
    font-weight: 800;
    line-height: 0.83;
    margin: 0;
    user-select: none;
  }
  .hello {
    font-size: clamp(120px, 14vw, 209px);
    left: 0;
    top: 0;
    color: var(--blue);
    z-index: 1;
  }
  .world {
    font-size: inherit;
    right: 0;
    top: var(--title-world-offset);
    color: var(--text);
    z-index: 3;
  }
  .hero-character {
    position: absolute;
    height: min(85dvh, 830px);
    width: auto;
    max-width: none;
    left: 50%;
    top: 50%;
    bottom: auto;
    z-index: 2;
    transform: translate3d(
        calc(-50% - var(--character-optical-shift, 38px) + var(--px, 0px)),
        calc(-50% + var(--py, 0px)),
        0
      )
      rotate(var(--character-click-rotate, 0deg)) scale(var(--character-click-scale, 1));
    filter: drop-shadow(0 18px 24px rgba(36, 100, 237, 0.1));
    transition: transform 0.1s ease-out;
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }
  .hero-copy {
    position: absolute;
    left: clamp(20px, 4.5vw, 56px);
    bottom: clamp(96px, 12vh, 120px);
    z-index: 5;
    max-width: 400px;
  }
  .hero-copy h1 {
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.5;
    font-weight: 650;
    margin: 0 0 11px;
  }
  .hero-copy h1 span {
    display: block;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 5px;
    font-weight: 450;
  }
  .hero-copy p {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.85;
    margin: 0;
  }
  .hero-actions {
    position: absolute;
    left: clamp(20px, 4.5vw, 56px);
    bottom: clamp(28px, 4vh, 36px);
    display: flex;
    gap: 12px;
    z-index: 6;
  }
  .hero-aside {
    position: absolute;
    right: clamp(20px, 4.5vw, 56px);
    bottom: clamp(32px, 4.5vh, 42px);
    width: 220px;
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
    z-index: 5;
  }
  .hero-aside small {
    display: block;
    color: var(--muted);
    font-size: 9px;
    margin-top: 10px;
    letter-spacing: 0.05em;
  }
  .section-heading-stacked {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .section-heading-stacked p {
    max-width: none;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 15px;
  }
  .daily {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 30px;
    min-height: 235px;
    position: relative;
    overflow: hidden;
    background: var(--surface);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .daily:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
  }
  .daily:nth-child(1),
  .daily:nth-child(4) {
    grid-column: span 7;
  }
  .daily:nth-child(2),
  .daily:nth-child(3) {
    grid-column: span 5;
  }
  .daily:nth-child(1) {
    background: var(--blue);
    color: #ffffff;
    border-color: var(--blue);
  }
  .daily:nth-child(4) {
    background: var(--ice);
  }
  .daily-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 38px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .daily:nth-child(1) .daily-top {
    color: #d9e6ff;
  }
  .daily h3 {
    font-size: 23px;
    font-weight: 600;
    margin: 0 0 9px;
    position: relative;
    z-index: 1;
  }
  .daily p {
    font-size: 12px;
    max-width: 310px;
    color: var(--muted);
    margin: 0;
    position: relative;
    z-index: 1;
    line-height: 1.8;
  }
  .daily:nth-child(1) p {
    color: #e5edff;
  }
  .daily-symbol {
    position: absolute;
    right: 29px;
    bottom: 8px;
    font-size: 86px;
    line-height: 1;
    color: var(--blue);
    opacity: 0.15;
    font-weight: 600;
    user-select: none;
    pointer-events: none;
  }
  .daily:nth-child(1) .daily-symbol {
    color: #ffffff;
    opacity: 0.22;
    font-size: 73px;
  }
  .daily-symbol.orange {
    color: var(--orange);
    opacity: 0.28;
  }
  .start {
    background: var(--ice);
    padding: 74px 0 84px;
  }
  .start-intro {
    text-align: center;
    margin-bottom: 54px;
  }
  .start-intro p {
    font-size: 15px;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .start-intro h2 {
    font-size: clamp(32px, 3.8vw, 45px);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }
  .start-intro h2 span {
    color: var(--blue);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .step {
    border-top: 1px solid var(--line);
    padding: 24px 31px 0 0;
    position: relative;
  }
  .step:not(:first-child) {
    padding-left: 31px;
    border-left: 1px solid var(--line);
  }
  .step-number {
    font-size: 11px;
    color: var(--orange);
    margin-bottom: 28px;
    display: block;
    font-weight: 600;
  }
  .step h3 {
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 13px;
  }
  .step p {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 26px;
    line-height: 1.8;
  }
  .latest-grid {
    display: grid;
    grid-template-columns: 1.42fr 1fr;
    gap: 30px;
  }
  .news-cover {
    width: 100%;
    height: 315px;
    object-fit: cover;
    border-radius: 5px;
  }
  .meta {
    display: flex;
    gap: 15px;
    align-items: center;
    font-size: 10px;
    color: var(--muted);
    margin: 17px 0 12px;
  }
  .meta .type {
    color: var(--blue);
    font-weight: 600;
  }
  .lead-story h3 {
    font-size: 28px;
    font-weight: 600;
    line-height: 1.45;
    margin: 0 0 10px;
  }
  .lead-story p {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
    line-height: 1.8;
  }
  .side-story {
    display: grid;
    grid-template-columns: 1fr 144px;
    gap: 21px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 25px;
  }
  .side-story + .side-story {
    padding-top: 26px;
  }
  .side-story .meta {
    margin: 0 0 12px;
  }
  .side-story h3 {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.55;
    margin: 0 0 11px;
  }
  .side-story p {
    font-size: 11px;
    color: var(--muted);
    margin: 0;
    line-height: 1.8;
  }
  .side-story img {
    height: 147px;
    width: 144px;
    object-fit: cover;
    border-radius: 4px;
  }
  .story-art {
    width: 144px;
    height: 147px;
    background: var(--ice);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 49px;
    font-weight: 650;
    color: var(--blue);
    user-select: none;
  }
  .latest-note {
    font-size: 11px;
    color: var(--muted);
    margin-top: 25px;
    display: flex;
    gap: 10px;
  }
  .latest-note span {
    color: var(--orange);
  }
  .projects {
    padding: 79px 0 87px;
    background: var(--ice);
    overflow: hidden;
  }
  .project-heading h2 {
    font-size: clamp(32px, 3.6vw, 43px);
  }
  .project-display {
    background: #e0eaff;
    border: 1px solid #cbd9f4;
    border-radius: 6px;
    overflow: hidden;
    padding: 29px 46px 0;
    max-width: 1100px;
    margin: auto;
    display: block;
    transition: transform 0.25s ease;
  }
  .project-display:hover {
    transform: translateY(-3px);
  }
  :global(:root[data-theme='dark']) .project-display {
    background: #1b2230;
    border-color: #2b364d;
  }
  .project-display img {
    width: 100%;
    height: auto;
    border-radius: 5px 5px 0 0;
    box-shadow: 0 7px 25px rgba(28, 67, 137, 0.1);
  }
  .project-description {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 75px;
    margin-top: 29px;
    align-items: start;
  }
  .project-title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 11px;
  }
  .project-title h3 {
    font-size: 30px;
    line-height: 1.2;
    font-weight: 650;
    margin: 0;
  }
  .project-title span {
    font-size: 10px;
    color: var(--orange);
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .project-description p {
    font-size: 13px;
    color: var(--muted);
    max-width: 475px;
    margin-bottom: 21px;
    line-height: 1.8;
  }
  .deploy-flow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 17px;
    padding: 9px 0;
    font-size: 11px;
  }
  .deploy-flow span {
    border-bottom: 1px solid var(--line);
    padding-bottom: 11px;
  }
  .deploy-flow b {
    color: var(--blue);
    margin-right: 10px;
    font-weight: 600;
  }
  .join-section {
    padding: 92px 0 86px;
    background: var(--ice);
    position: relative;
    z-index: 5;
  }
  .join-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 70px;
    align-items: center;
  }
  .join-section h2 {
    font-size: clamp(34px, 4vw, 45px);
    line-height: 1.45;
    font-weight: 600;
    margin: 0;
  }
  .join-section p {
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 23px;
    line-height: 1.8;
  }
  @media (max-width: 1150px) {
    .hello {
      font-size: 163px;
      top: 0;
    }
    .world {
      font-size: 161px;
      top: var(--title-world-offset);
    }
    .hero-copy {
      left: 36px;
      max-width: 320px;
    }
    .hero-actions {
      left: 36px;
    }
    .hero-aside {
      right: 36px;
      width: 180px;
    }
    .hero-character {
      height: min(80dvh, 720px);
      --character-optical-shift: 34px;
    }
    .hero-stage {
      --title-world-offset: 197px;
    }
  }

  @media (max-width: 800px) {
    .hero-stage {
      --title-world-offset: 225px;
    }
    .hello {
      font-size: 139px;
      left: 0;
      top: 0;
    }
    .world {
      font-size: 133px;
      right: 0;
      top: var(--title-world-offset);
    }
    .hero-character {
      height: min(72dvh, 600px);
      --character-optical-shift: 28px;
    }
    .hero-copy {
      left: 22px;
      bottom: 99px;
      max-width: 290px;
    }
    .hero-copy h1 {
      font-size: 20px;
    }
    .hero-copy p {
      font-size: 11px;
    }
    .hero-actions {
      left: 22px;
      bottom: 28px;
    }
    .hero-aside {
      right: 22px;
      width: 156px;
      bottom: 40px;
      font-size: 11px;
    }
    .bento {
      grid-template-columns: 1fr;
    }
    .daily:nth-child(1),
    .daily:nth-child(2),
    .daily:nth-child(3),
    .daily:nth-child(4) {
      grid-column: span 1;
    }
    .steps {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .step:not(:first-child) {
      border-left: none;
      padding-left: 0;
    }
    .latest-grid {
      grid-template-columns: 1fr;
    }
    .project-display {
      padding: 20px 20px 0;
    }
    .project-description {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .join-inner {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  @media (max-width: 520px) {
    .hero {
      min-height: 100dvh;
    }
    .hero-grid {
      background-size: 78px 78px;
    }
    .hello {
      font-size: 88px;
      left: 0;
      top: 0;
    }
    .world {
      font-size: 80px;
      right: 0;
      top: var(--title-world-offset);
    }
    .hero-character {
      height: min(65dvh, 480px);
      --character-optical-shift: 22px;
    }
    .hero-stage {
      --character-center-y: 50%;
      --title-center-y: var(--character-center-y);
      --title-world-offset: 110px;
    }
    .hero-copy {
      left: 18px;
      right: 18px;
      bottom: 93px;
      max-width: none;
    }
    .hero-aside {
      display: none;
    }
    .hero-actions {
      left: 18px;
      right: 18px;
      bottom: 26px;
      gap: 10px;
    }
    .hero-actions .button {
      flex: 1;
      justify-content: center;
      padding: 10px 12px;
      gap: 8px;
    }
  }

  @media (max-width: 350px) {
    .hero-actions {
      flex-direction: column;
      bottom: 20px;
    }
    .hero-copy {
      bottom: 120px;
    }
  }
  .ecosystem {
    padding-top: 79px;
  }
  .ecosystem > .wrap {
    padding-bottom: clamp(64px, 7vw, 96px);
  }
  .ecosystem .section-heading {
    margin: 0;
  }
  .ecosystem .eco-panel {
    min-height: inherit;
    padding: 58px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    align-items: center;
    gap: 62px;
  }
  .ecosystem .eco-number {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 39px;
  }
  .ecosystem .eco-journey-forge .eco-number,
  .ecosystem .eco-journey-play .eco-number,
  .ecosystem .eco-guide .eco-number,
  .ecosystem .eco-page .eco-number {
    color: #c1d3ff;
  }
  .ecosystem .eco-name {
    font-size: clamp(52px, 5.5vw, 81px);
    line-height: 1.05;
    font-weight: 700;
    margin: 0 0 20px;
  }
  .ecosystem .eco-headline {
    font-size: 25px;
    line-height: 1.25;
    font-weight: 650;
    margin: 0 0 14px;
  }
  .ecosystem .eco-content p {
    font-size: 13px;
    max-width: 440px;
    color: var(--muted);
    line-height: 1.8;
    margin: 0 0 31px;
  }
  .ecosystem .eco-journey-forge .eco-content p,
  .ecosystem .eco-journey-play .eco-content p,
  .ecosystem .eco-guide .eco-content p,
  .ecosystem .eco-page .eco-content p {
    color: #e5edff;
  }
  .ecosystem .eco-journey-forge .small-link,
  .ecosystem .eco-journey-play .small-link,
  .ecosystem .eco-guide .small-link,
  .ecosystem .eco-page .small-link {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.4);
  }
  .ecosystem .eco-visual {
    background: var(--ice);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 24px;
    height: 388px;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .ecosystem .eco-journey-begin .eco-visual {
    background: #eef2f6;
    border-color: #d8e2ee;
  }
  :root[data-theme='dark'] .ecosystem .eco-journey-begin .eco-visual {
    background: #181e2b;
    border-color: #273347;
  }
  .ecosystem .eco-journey-forge .eco-visual {
    background: #184cc2;
    border-color: #2c65e8;
  }
  .ecosystem .eco-journey-play .eco-visual {
    background: #0f1218;
    border-color: #252b37;
  }

  /* Journey Mockups */
  .journey-mockup {
    width: 100%;
    max-width: 480px;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    text-align: left;
  }
  .ecosystem .eco-panel:hover .journey-mockup {
    transform: translateY(-4px);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.22);
  }

  /* Card 1: Terminal Mockup */
  .terminal-mockup {
    background: #11141a;
    border: 1px solid #232936;
    color: #e2e8f0;
  }
  :root[data-theme='dark'] .terminal-mockup {
    background: #0d1017;
    border-color: #1f2637;
  }
  .mockup-header {
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    position: relative;
  }
  .mockup-dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-red {
    background: #ff5f56;
  }
  .dot-yellow {
    background: #ffbd2e;
  }
  .dot-green {
    background: #27c93f;
  }
  .mockup-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    color: #7d8799;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    white-space: nowrap;
  }
  .mockup-body {
    padding: 18px 20px;
    font-size: 12px;
    line-height: 1.65;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  .term-line {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 6px;
  }
  .prompt-arrow {
    color: #38d39f;
    font-weight: 700;
  }
  .prompt-path {
    color: #60a5fa;
  }
  .prompt-cmd {
    color: #ffffff;
    font-weight: 500;
  }
  .term-line.success {
    color: #94a3b8;
    font-size: 11px;
    padding-left: 2px;
  }
  .term-output {
    margin: 10px 0 12px;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.04);
    border-left: 2px solid #3b82f6;
    border-radius: 0 4px 4px 0;
    font-size: 11px;
    color: #cbd5e1;
    font-style: italic;
  }
  .term-cursor-line {
    display: flex;
    gap: 8px;
    align-items: center;
    color: #60a5fa;
  }
  .cursor {
    color: #38d39f;
    animation: blink 1s step-end infinite;
    font-weight: 700;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Card 2: Git PR Mockup */
  .pr-mockup {
    background: rgba(13, 38, 98, 0.7);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 22px;
    color: #ffffff;
  }
  .pr-top-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .pr-badge {
    background: #8957e5;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .pr-repo {
    font-size: 11px;
    color: #c1d3ff;
    font-family: ui-monospace, monospace;
  }
  .pr-id {
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
  }
  .pr-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 8px;
    color: #ffffff;
  }
  .pr-meta-row {
    font-size: 11px;
    color: #c1d3ff;
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 18px;
  }
  .pr-status {
    color: #4ade80;
    font-weight: 500;
  }
  .pr-timeline {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 18px;
    border-left: 2px solid rgba(255, 255, 255, 0.15);
    padding-left: 14px;
    margin-left: 6px;
  }
  .timeline-item {
    position: relative;
  }
  .tl-icon {
    position: absolute;
    left: -20px;
    top: 2px;
    font-size: 10px;
  }
  .tl-icon.commit {
    color: #60a5fa;
  }
  .tl-icon.review {
    color: #4ade80;
  }
  .tl-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tl-msg {
    font-size: 12px;
    font-weight: 500;
    color: #ffffff;
  }
  .tl-hash {
    font-size: 10px;
    color: #a5b4fc;
    font-family: ui-monospace, monospace;
  }
  .tl-sub {
    font-size: 11px;
    color: #e0e7ff;
    font-style: italic;
    opacity: 0.9;
  }
  .pr-stats-row {
    display: flex;
