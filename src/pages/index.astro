---
import { ArrowRight, ArrowUpRight } from 'lucide-astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../config';
import StackScroll from '../widgets/StackScroll.astro';
import StackScrollCard from '../widgets/StackScrollCard.astro';
import { getArticleCategory, getArticleCover } from '../articles';

const { site: siteData, recruitment } = config;
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featuredArticle = articles.find((entry) => entry.data.featured) || articles[0];
const sideArticles = articles.filter((entry) => entry.id !== featuredArticle?.id).slice(0, 2);
---

<BaseLayout title={siteData.title} description={siteData.description}>
  <!-- Hero section matching design (full dvh, massive HELLO/WORLD, mascot parallax, kicker & index removed) -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="hero-stage">
      <div class="hero-title-lockup">
        <div class="hello" aria-hidden="true">HELLO</div>

        <div class="world" aria-hidden="true">WORLD.</div>
      </div>

      <img
        class="hero-character"
        src="/assets/characters/shurin-aran/hero.png"
        alt="Shurin Aran，计协娘"
        width="1024"
        height="1536"
        fetchpriority="high"
        data-hero-mascot
      />
    </div>

    <div class="hero-copy">
      <h1 id="hero-title">
        <span>欢迎来到</span>东南大学成贤学院<br />计算机协会
      </h1>
      <p>
        在纯粹的逻辑与无穷的构想之间，<br />用代码敲出真实世界的回响。
      </p>
    </div>

    <div class="hero-actions">
      <a class="button button-primary" href="#what-we-do">
        看看我们在做什么 <ArrowRight size={14} />
      </a>
      <a class="button button-secondary" href="/join">
        加入计协 <ArrowUpRight size={14} />
      </a>
    </div>

    <div class="hero-aside">
      代码赋予思想形状，<br />好奇赋予代码意义。
      <small>CODE GIVES FORM. CURIOSITY GIVES MEANING.</small>
    </div>
  </section>

  <!-- Section 02 / What We Do (Bento cards) -->
  <section class="section wrap" id="what-we-do" aria-labelledby="what-title">
    <div class="section-line">WHAT WE DO</div>
    <div class="section-heading">
      <h2 id="what-title">在课堂之外，<br />探索技术与创造的边界。</h2>
      <p>从底层原理的推敲，到面向现实的工程构筑。我们聚集于此，让抽象的构想落地生根，让未解的疑问找到答案。</p>
    </div>

    <div class="bento">
      <article class="daily">
        <div class="daily-top">
          <span>01 / LEARN</span>
          <span>探究本质</span>
        </div>
        <h3>理解原理，而非止于使用</h3>
        <p>从系统的底层运转，到现代应用的设计与工程。<br />我们不仅学习运用工具，更去理解其背后的逻辑与美感。</p>
        <span class="daily-symbol" aria-hidden="true">&lt;/&gt;</span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>02 / BUILD</span>
          <span>构建即是思考</span>
        </div>
        <h3>从无到有地构建</h3>
        <p>一个解决校园痛点的脚本、一个服务师生的平台，或是一场纯粹的技术实验。<br />只要敲下代码，想法便有了实体。</p>
        <span class="daily-symbol orange" aria-hidden="true">↗</span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>03 / TEAM UP</span>
          <span>协作攻坚</span>
        </div>
        <h3>在竞技与协作中沉淀</h3>
        <p>在各类赛事与黑客松中并肩攻坚。<br />复杂的工程从不是孤胆英雄的舞台，团队协作让每一个难关都有所支撑。</p>
        <span class="daily-symbol" aria-hidden="true">&#123; &#125;</span>
      </article>

      <article class="daily">
        <div class="daily-top">
          <span>04 / TOGETHER</span>
          <span>长久共鸣</span>
        </div>
        <h3>找到同频的探索者</h3>
        <p>工具与技术总在更迭，但那些<br />深夜并肩调试 Bug、因突破而击掌相庆的同伴，始终是大学里最珍贵的印记。</p>
        <span class="daily-symbol" aria-hidden="true">++</span>
      </article>
    </div>
  </section>

  <!-- Section 03 / Start Here -->
  <section class="start" id="start-here" aria-labelledby="start-title">
    <div class="wrap">
      <div class="section-line">START HERE</div>
      <div class="start-intro">
        <p>“每一个庞大精密的系统，最初都来自一个空白的文件。”</p>
        <h2 id="start-title">不必先行万步，<span>从第一行开始。</span></h2>
      </div>

      <div class="steps">
        <article class="step">
          <span class="step-number">01 →</span>
          <h3>从零开始</h3>
          <p>面对庞杂的技术栈，迷茫是常态。<br />我们梳理了踩坑经验与进阶路线，助你拨开迷雾，找到踏实的起点。</p>
          <a class="small-link" href={siteData.guideUrl} target="_blank" rel="noopener noreferrer">
            打开 CXCS Guide <ArrowUpRight size={13} />
          </a>
        </article>

        <article class="step">
          <span class="step-number">02 →</span>
          <h3>付诸工程</h3>
          <p>真正的理解发生在创造之中。<br />哪怕只是修改几个参数、解决一个小问题，亲自运行代码才是真正的领悟。</p>
          <a class="small-link" href="/articles">
            阅读探索与实践 <ArrowRight size={13} />
          </a>
        </article>

        <article class="step">
          <span class="step-number">03 ↗</span>
          <h3>把它分享出去</h3>
          <p>
            写完的代码，不应该只留在自己的电脑里。<br />把项目部署上线，让大家真正用上你的作品，新的交流也会随之发生。
          </p>
          <a class="small-link" href={siteData.pageUrl} target="_blank" rel="noopener noreferrer">
            用 CXCS Page 发布 <ArrowUpRight size={13} />
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Section 04 / Latest from CXCS -->
  <section class="section wrap" id="latest" aria-labelledby="latest-title">
    <div class="section-line">LATEST FROM CXCS</div>
    <div class="section-heading">
      <h2 id="latest-title">近期的记录、<br />思考与回声。</h2>
      <a class="small-link" href="/articles">全部文章 <ArrowRight size={14} /></a>
    </div>

    <div class="latest-grid">
      {
        featuredArticle && (
          <a class="lead-story" href={`/articles/${featuredArticle.id}`}>
            <img
              class="news-cover"
              src={getArticleCover(featuredArticle)}
              alt={featuredArticle.data.cover?.alt || featuredArticle.data.title}
              loading="lazy"
            />
            <div class="meta">
              <span class="type">{getArticleCategory(featuredArticle.data.type).label}</span>
              <span>·</span>
              <span>{featuredArticle.data.publishedAt.toLocaleDateString('zh-CN')}</span>
              {featuredArticle.data.authors.length > 0 && (
                <>
                  <span>·</span>
                  <span>{featuredArticle.data.authors.join(' / ')}</span>
                </>
              )}
            </div>
            <h3>{featuredArticle.data.title}</h3>
            <p>{featuredArticle.data.description}</p>
          </a>
        )
      }

      <div class="side-stories">
        {
          sideArticles.map((article) => (
            <a class="side-story" href={`/articles/${article.id}`}>
              <div>
                <div class="meta">
                  <span class="type">{getArticleCategory(article.data.type).label}</span>
                  <span>·</span>
                  <span>{article.data.publishedAt.toLocaleDateString('zh-CN')}</span>
                </div>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </div>
              <img src={getArticleCover(article)} alt={article.data.cover?.alt || article.data.title} loading="lazy" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 06 / Ecosystem -->
  <section class="ecosystem" id="ecosystem" aria-labelledby="ecosystem-title">
    <div class="wrap">
      <div class="section-line">CXCS ECOSYSTEM</div>
      <div class="section-heading">
        <h2 id="ecosystem-title">从初次探索，<br />到独立交付。</h2>
        <p>贯穿学习、实践与创造的完整过程。</p>
      </div>
    </div>

    <StackScroll>
      <StackScrollCard>
        <div class="wrap eco-panel eco-website">
          <div class="eco-content">
            <div class="eco-number">01 / MEET</div>
            <h3 class="eco-name">Website</h3>
            <h4 class="eco-headline">认识我们，也找到彼此。</h4>
            <p>记录协会的前沿动态、开源项目与成员轨迹。这里是对外开放的窗口，也是你与一群志同道合者相遇的起点。</p>
            <a class="small-link" href="#what">认识计算机协会 <ArrowRight size={14} /></a>
          </div>
          <div class="eco-visual">
            <img
              src="/assets/ecosystem/emblem.png"
              alt="东南大学成贤学院计算机协会完整社徽"
              width="226"
              height="226"
              loading="lazy"
            />
          </div>
        </div>
      </StackScrollCard>

      <StackScrollCard background="#2464ed" color="#ffffff" borderColor="#2464ed">
        <div class="wrap eco-panel eco-guide">
          <div class="eco-content">
            <div class="eco-number">02 / LEARN</div>
            <h3 class="eco-name">Guide</h3>
            <h4 class="eco-headline">前人踩过的坑，你的起点。</h4>
            <p>从开发环境配置到进阶技术路线。历届成员把踩过的坑和积累的经验整理成册，让你不必在迷茫中独自摸索。</p>
            <a class="small-link" href={siteData.guideUrl} target="_blank" rel="noopener noreferrer">
              前往 CXCS Guide <ArrowUpRight size={14} />
            </a>
          </div>
          <div class="eco-visual">
            <img
              src="/assets/ecosystem/guide-screen.png"
              alt="CXCS Guide 学习指南的真实网页界面"
              width="1440"
              height="1000"
              loading="lazy"
            />
          </div>
        </div>
      </StackScrollCard>

      <StackScrollCard background="#171b23" color="#ffffff" borderColor="#171b23">
        <div class="wrap eco-panel eco-page">
          <div class="eco-content">
            <div class="eco-number">03 / DEPLOY</div>
            <h3 class="eco-name">Page</h3>
            <h4 class="eco-headline">把项目交托上线，专注创造本身。</h4>
            <p>免去繁琐的服务器运维门槛。关联代码仓库即可自动完成构建，把更多时间留给写出真正有价值的代码。</p>
            <a class="small-link" href={siteData.pageUrl} target="_blank" rel="noopener noreferrer">
              前往 CXCS Page <ArrowUpRight size={14} />
            </a>
          </div>
          <div class="eco-visual">
            <img
              src="/assets/ecosystem/page-screen.png"
              alt="CXCS Page 网站的真实界面"
              width="1440"
              height="1000"
              loading="lazy"
            />
          </div>
        </div>
      </StackScrollCard>
    </StackScroll>
  </section>

  <!-- Section 07 / Join Us -->
  <section class="join-section" id="join-us" aria-labelledby="join-title">
    <div class="wrap">
      <div class="section-line">JOIN US</div>
      <div class="join-inner">
        <h2 id="join-title">下一段航程，<br />期待与你同行。</h2>
        <div>
          <p>
            技能可以从零研习，经验可以慢慢沉淀，但对探索的热望不可替代。<br
            />只要你对计算机的世界怀有好奇，这里便有属于你的一席之地。
          </p>
          <a class="button button-primary" href="/join">
            加入计算机协会 <ArrowRight size={14} />
          </a>
          <span class="join-status">
            {recruitment.title} · 公开 QQ 交流群 {recruitment.qqGroup}
          </span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script src="../assets/scripts/home-motion.ts"></script>

<style>
  .ecosystem {
    padding-top: 79px;
  }
  .ecosystem > .wrap {
    padding-bottom: clamp(64px, 7vw, 96px);
  }
  .ecosystem .section-heading {
    margin: 0;
  }
  .ecosystem .eco-panel {
    height: 100%;
    padding: 58px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    align-items: center;
    gap: 62px;
  }
  .ecosystem .eco-number {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 39px;
  }
  .ecosystem .eco-guide .eco-number,
  .ecosystem .eco-page .eco-number {
    color: #c1d3ff;
  }
  .ecosystem .eco-name {
    font-size: clamp(52px, 5.5vw, 81px);
    line-height: 1.05;
    font-weight: 700;
    margin: 0 0 20px;
  }
  .ecosystem .eco-headline {
    font-size: 25px;
    line-height: 1.25;
    font-weight: 650;
    margin: 0 0 14px;
  }
  .ecosystem .eco-content p {
    font-size: 13px;
    max-width: 440px;
    color: var(--muted);
    line-height: 1.8;
    margin: 0 0 31px;
  }
  .ecosystem .eco-guide .eco-content p,
  .ecosystem .eco-page .eco-content p {
    color: #e5edff;
  }
  .ecosystem .eco-guide .small-link,
  .ecosystem .eco-page .small-link {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.4);
  }
  .ecosystem .eco-visual {
    background: var(--ice);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 30px;
    height: 388px;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .ecosystem .eco-website .eco-visual {
    background: #d8e5ff;
    border-color: #bfd4ff;
  }
  :root[data-theme='dark'] .ecosystem .eco-website .eco-visual {
    background: #1d2535;
    border-color: #2b384f;
  }
  .ecosystem .eco-website .eco-visual img {
    width: 226px;
    height: 226px;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 14px 28px rgba(36, 100, 237, 0.22));
    transition: transform 0.3s ease;
  }
  .ecosystem .eco-website:hover .eco-visual img {
    transform: scale(1.05);
  }
  .ecosystem .eco-guide .eco-visual {
    background: #184cc2;
    border-color: #2c65e8;
  }
  .ecosystem .eco-page .eco-visual {
    background: #0f1218;
    border-color: #252b37;
  }
  .ecosystem .eco-guide .eco-visual img,
  .ecosystem .eco-page .eco-visual img {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    border-radius: 5px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    transition: transform 0.3s ease;
  }
  .ecosystem .eco-panel:hover .eco-visual img {
    transform: translateY(-4px);
  }

  @media (max-width: 900px) {
    .ecosystem .eco-panel {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      gap: 20px;
      padding: 28px 0;
    }
    .ecosystem .eco-number {
      margin-bottom: 12px;
    }
    .ecosystem .eco-name {
      font-size: 44px;
      margin-bottom: 12px;
    }
    .ecosystem .eco-headline {
      font-size: 20px;
      margin-bottom: 10px;
    }
    .ecosystem .eco-content p {
      margin-bottom: 16px;
    }
    .ecosystem .eco-visual {
      height: 100%;
      padding: 16px;
    }
  }
</style>
