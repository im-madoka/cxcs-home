---
import Button from '../../../components/Button.astro';
import 'katex/dist/katex.min.css';
import { getCollection, render } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import config from '../../../config';
import { getArticleCategory, getArticleCover } from '../../../articles';
const { site: siteData } = config;

const entries = await getCollection('articles');

export async function getStaticPaths() {
  const allEntries = await getCollection('articles');
  return allEntries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({ params: { type: entry.data.type, slug: entry.id.split('/')[1] }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const category = getArticleCategory(entry.data.type);

const related = entries
  .filter(
    (item) =>
      item.id !== entry.id &&
      !item.data.draft &&
      (item.data.type === entry.data.type || item.data.tags.some((tag) => entry.data.tags.includes(tag))),
  )
  .slice(0, 2);
---

<BaseLayout
  title={`${entry.data.title} · ${siteData.shortName}`}
  description={entry.data.description}
  image={getArticleCover(entry)}
>
  <div class="reading-progress" aria-hidden="true"></div>

  <article class="article-detail">
    <!-- Header -->
    <header class="detail-hero">
      <div class="wrap detail-hero-content">
        <div class="section-line">
          <span>{entry.data.type.toUpperCase()}</span>
          <span>·</span>
          <span>{entry.data.publishedAt.toLocaleDateString('zh-CN')}</span>
        </div>
        <h1>{entry.data.title}</h1>
        <p class="detail-desc">{entry.data.description}</p>
        <div class="detail-byline">
          {entry.data.authors.length > 0 && <span>作者 / {entry.data.authors.join('、')}</span>}
          <span>{category.byline}</span>
        </div>
      </div>
    </header>

    <!-- Cover Media -->
    {entry.data.cover?.image && (
      <div class="wrap detail-cover-wrap">
        <img class="detail-cover" src={getArticleCover(entry)} alt={entry.data.cover.alt || entry.data.title} />
        {entry.data.cover.caption && <p class="detail-cover-caption">{entry.data.cover.caption}</p>}
      </div>
    )}

    <!-- Content Body -->
    <div class="article-body-container">
      <div class="article-body">
        <Content />
      </div>
    </div>

    <!-- Footer & Related -->
    <footer class="article-footer wrap">
      <div class="footer-nav-back">
        <Button variant="secondary" href="/articles">
          <ArrowLeft size={14} /> 返回文章列表
        </Button>
      </div>

      {related.length > 0 && (
        <div class="related-block">
          <div class="section-line">
            <span>RECOMMENDED</span>
          </div>
          <div class="related-grid">
            {related.map((item) => (
              <a class="related-link" href={`/articles/${item.id}`}>
                <span class="related-type">{item.data.type.toUpperCase()}</span>
                <h3>{item.data.title}</h3>
                <p>{item.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </footer>
  </article>
</BaseLayout>

<script>
  import { onPageLoad } from '../../../assets/scripts/page-load';
  import { reveal } from '../../../assets/scripts/reveal';

  let progressElement: HTMLElement | null = null;
  let progressHandler: (() => void) | null = null;

  const clearReadingProgress = () => {
    if (progressHandler) window.removeEventListener('scroll', progressHandler);
    progressHandler = null;
    progressElement = null;
  };

  onPageLoad(() => {
    const hero = document.querySelector('.detail-hero');
    reveal(hero?.querySelectorAll('h1, .detail-byline'), {
      y: 20,
      duration: 0.65,
      stagger: 0.08,
    });

    clearReadingProgress();
    progressElement = document.querySelector<HTMLElement>('.reading-progress');
    if (progressElement) {
      progressHandler = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progressElement!.style.transform = `scaleX(${max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0})`;
      };
      progressHandler();
      window.addEventListener('scroll', progressHandler, { passive: true });
    }
  });

  document.addEventListener('astro:before-swap', clearReadingProgress);
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--blue);
    transform-origin: left center;
    transform: scaleX(0);
    z-index: 100;
    pointer-events: none;
  }

  .detail-hero {
    padding: calc(var(--header-height) + 54px) 0 42px;
    background: var(--ice);
    border-bottom: 1px solid var(--line);
  }
  .detail-hero-content {
    max-width: 1040px;
  }
  .detail-hero h1 {
    font-size: clamp(34px, 4.5vw, 52px);
    line-height: 1.3;
    font-weight: 700;
    margin: 0 0 16px;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .detail-desc {
    font-size: 18px;
    color: var(--muted);
    line-height: 1.8;
    margin: 0 0 24px;
  }
  .detail-byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    font-size: 13px;
    color: var(--muted);
  }

  .detail-cover-wrap {
    margin-top: 36px;
  }
  .detail-cover {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--line);
  }
  .detail-cover-caption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 12px;
  }

  .article-body-container {
    padding: 56px 0 72px;
  }
  .article-body {
    width: min(760px, calc(100% - 48px));
    margin: 0 auto;
    font-size: 20px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
  .article-body :global(h2) {
    font-size: 1.5em;
    font-weight: 650;
    line-height: 1.4;
    margin: 44px 0 18px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }
  .article-body :global(h2:first-child) {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }
  .article-body :global(h3) {
    font-size: 1.2em;
    font-weight: 600;
    margin: 32px 0 14px;
  }
  .article-body :global(p) {
    margin: 0 0 22px;
    color: var(--text);
  }
  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 24px;
    padding-left: 24px;
  }
  .article-body :global(li) {
    margin-bottom: 8px;
  }
  .article-body :global(blockquote) {
    margin: 28px 0;
    padding: 18px 24px;
    border-left: 3px solid var(--blue);
    background: var(--ice);
    border-radius: 0 4px 4px 0;
    font-size: 1em;
    color: var(--muted);
  }
  .article-body :global(pre) {
    padding: 20px 24px;
    border-radius: 6px;
    overflow-x: auto;
    margin: 28px 0;
    font-size: 0.9em;
    border: 1px solid var(--line);
  }
  .article-body :global(code) {
    font-family: monospace;
    font-size: 0.9em;
  }
  .article-body :global(pre code) {
    font-size: inherit;
  }
  .article-body :global(.katex-display) {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.25em 0;
  }

  .article-footer {
    padding: 48px 0 72px;
    border-top: 1px solid var(--line);
  }
  .footer-nav-back {
    margin-bottom: 48px;
  }
  .related-block {
    margin-top: 24px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .related-link {
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--surface);
    padding: 24px;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .related-link:hover {
    transform: translateY(-2px);
    border-color: var(--blue);
  }
  .related-type {
    font-size: 10px;
    color: var(--blue);
    font-weight: 700;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 8px;
  }
  .related-link h3 {
    font-size: 18px;
    font-weight: 650;
    line-height: 1.4;
    margin: 0 0 8px;
  }
  .related-link p {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .article-body {
      font-size: 18px;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
