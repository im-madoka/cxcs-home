---
import { getCollection } from 'astro:content';
import { ArrowRight } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { siteData } from '../../config';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featured = articles.find((entry) => entry.data.featured) || articles[0];
const rest = articles.filter((entry) => entry.id !== featured?.id);
---

<BaseLayout
  title={`Articles · ${siteData.shortName}`}
  description="记录折腾的过程，分享踩过的坑，也留下一些值得被记住的尝试。"
>
  <PageHero
    eyebrow="CXCS EDITORIAL"
    title="文章与动态。"
    description="记录折腾的过程，分享踩过的坑，也留下一些值得被记住的尝试。"
  />

  <!-- Feed Section -->
  <section class="section articles-section">
    <div class="wrap">
      <!-- Underline Filter Tabs -->
      <nav class="filter-tabs" aria-label="文章分类">
        <a class="tab-link is-active" href="/articles" aria-current="page">全部</a>
        <a class="tab-link" href="/articles/news">新闻</a>
        <a class="tab-link" href="/articles/blog">博客</a>
      </nav>

      <!-- Featured Story Card -->
      {
        featured && (
          <a class="story-card" href={`/articles/${featured.id}`}>
            <img
              class="story-cover"
              src={featured.data.cover?.image || `/generated/article-covers/${featured.id}.webp`}
              alt={featured.data.cover?.alt || featured.data.title}
              loading="lazy"
            />
            <div class="story-content">
              <div class="eyebrow">
                {featured.data.type === 'news' ? 'NEWS' : 'BLOG'} ·{' '}
                {featured.data.publishedAt.toLocaleDateString('zh-CN')}
              </div>
              <h3>{featured.data.title}</h3>
              <p>{featured.data.description}</p>
              <span class="arrow-link">
                阅读全文 <ArrowRight size={15} />
              </span>
            </div>
          </a>
        )
      }

      <!-- Normal Article Grid -->
      <div class="editorial-grid">
        {
          rest.map((article) => (
            <article class="editorial-item">
              <a class="article-card" href={`/articles/${article.id}`}>
                <div class="article-cover">
                  <img
                    src={article.data.cover?.image || `/generated/article-covers/${article.id}.webp`}
                    alt={article.data.cover?.alt || article.data.title}
                    loading="lazy"
                  />
                </div>
                <div class="article-body">
                  <div class="article-meta">
                    <span class="article-type">{article.data.type === 'news' ? '新闻' : '博客'}</span>
                    <span>·</span>
                    <span>{article.data.publishedAt.toLocaleDateString('zh-CN')}</span>
                    {article.data.authors.length > 0 && (
                      <>
                        <span>·</span>
                        <span>{article.data.authors.join(' / ')}</span>
                      </>
                    )}
                  </div>
                  <h3>{article.data.title}</h3>
                  <p>{article.data.description}</p>
                  <span class="article-more">
                    阅读全文 <ArrowRight size={13} />
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .articles-section {
    padding: 42px 0 96px;
  }

  /* Filter Tabs with Active Underline Indicator */
  .filter-tabs {
    display: flex;
    gap: 32px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }
  .tab-link {
    position: relative;
    padding: 0 2px 14px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .tab-link:hover {
    color: var(--text);
  }
  .tab-link.is-active,
  .tab-link[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
  }
  .tab-link.is-active::after,
  .tab-link[aria-current='page']::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--blue);
    border-radius: 1px;
    content: '';
  }

  /* Featured Story Card */
  .story-card {
    position: relative;
    min-height: 440px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(32px, 5vw, 52px);
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: #14171d;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.1);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }
  .story-card:hover {
    transform: translateY(-4px);
    border-color: var(--blue);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.2);
  }
  .story-card::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(15, 20, 26, 0.96) 0%, rgba(15, 20, 26, 0.82) 48%, rgba(15, 20, 26, 0.25) 100%),
      linear-gradient(0deg, rgba(15, 20, 26, 0.94) 0%, rgba(15, 20, 26, 0.35) 50%, transparent 100%);
    content: '';
  }
  .story-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    transition: transform 0.6s ease;
  }
  .story-card:hover .story-cover {
    transform: scale(1.03);
  }
  .story-content {
    position: relative;
    z-index: 2;
    max-width: 620px;
    color: #ffffff;
  }
  .story-content .eyebrow {
    color: var(--blue);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .story-content h3 {
    max-width: 600px;
    margin: 0 0 16px;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.16;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ffffff;
  }
  .story-content p {
    max-width: 520px;
    margin: 0 0 24px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 15px;
    line-height: 1.75;
  }
  .story-content .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    transition:
      gap 0.2s ease,
      color 0.2s ease;
  }
  .story-card:hover .story-content .arrow-link {
    gap: 12px;
    color: var(--blue);
  }

  /* Normal Editorial Grid */
  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 48px;
  }
  .editorial-item {
    display: flex;
  }

  /* Full-bleed Top Image Card */
  .article-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .article-card:hover {
    transform: translateY(-4px);
    border-color: var(--blue);
    box-shadow: var(--shadow);
  }
  .article-cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--surface-strong);
  }
  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .article-card:hover .article-cover img {
    transform: scale(1.04);
  }
  .article-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 22px 24px 24px;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .article-type {
    color: var(--blue);
    font-weight: 700;
  }
  .article-card h3 {
    font-size: 20px;
    font-weight: 650;
    line-height: 1.4;
    margin: 0 0 10px;
    color: var(--text);
    transition: color 0.15s ease;
  }
  .article-card:hover h3 {
    color: var(--blue);
  }
  .article-card p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 18px;
  }
  .article-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    font-size: 12px;
    font-weight: 600;
    color: var(--blue);
    transition: gap 0.15s ease;
  }
  .article-card:hover .article-more {
    gap: 10px;
  }

  @media (max-width: 980px) {
    .editorial-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
  }

  @media (max-width: 640px) {
    .filter-tabs {
      gap: 20px;
      margin-bottom: 28px;
    }
    .story-card {
      min-height: 380px;
      padding: 28px 24px;
    }
    .story-card::before {
      background: linear-gradient(
        0deg,
        rgba(15, 20, 26, 0.98) 0%,
        rgba(15, 20, 26, 0.85) 60%,
        rgba(15, 20, 26, 0.4) 100%
      );
    }
    .editorial-grid {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }
  }
</style>
