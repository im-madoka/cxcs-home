---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import BrandPlaceholder from '../../components/BrandPlaceholder.astro';
import { siteData } from '../../data/site';
const entries = await getCollection('articles');
export async function getStaticPaths() {
  const allEntries = await getCollection('articles');
  return allEntries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const related = entries
  .filter(
    (item) =>
      item.id !== entry.id &&
      !item.data.draft &&
      (item.data.type === entry.data.type || item.data.tags.some((tag) => entry.data.tags.includes(tag))),
  )
  .slice(0, 3);
---

<BaseLayout
  title={`${entry.data.title} · ${siteData.shortName}`}
  description={entry.data.description}
  image={entry.data.cover?.image}
>
  <article>
    <header class="detail-hero">
      <div class="detail-header container">
        <p class="eyebrow">{entry.data.type} · {entry.data.publishedAt.toLocaleDateString('zh-CN')}</p><h1>
          {entry.data.title}
        </h1><p>{entry.data.description}</p><div class="detail-byline">
          {entry.data.authors.length > 0 && <span>作者 / {entry.data.authors.join('、')}</span>}<span
            >{entry.data.type === 'news' ? 'CXCS 官方发布' : 'CXCS Editorial'}</span
          >
        </div>
      </div>
    </header>
    <div class="detail-cover">
      {
        entry.data.cover ? (
          <img src={entry.data.cover.image} alt={entry.data.cover.alt} />
        ) : (
          <BrandPlaceholder label={entry.data.type.toUpperCase()} />
        )
      }
    </div>
    <div class="reading-progress" aria-hidden="true"></div>
    <div class="article-body"><Content /></div>
    <footer class="article-footer">
      <ArrowLink href="/articles" label="返回 Articles" />{
        related.length > 0 && (
          <div class="related-block">
            <>
              <p class="eyebrow">继续看看</p>
              <div class="related-grid">
                {related.map((item) => (
                  <a class="related-link" href={`/articles/${item.id}`}>
                    <p>{item.data.type}</p>
                    <h3>{item.data.title}</h3>
                  </a>
                ))}
              </div>
            </>
          </div>
        )
      }
    </footer>
  </article>
</BaseLayout>
