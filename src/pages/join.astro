---
import { ArrowRight, ArrowUpRight, Clock3, Users } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import SectionIntro from '../components/SectionIntro.astro';
import StatusPill from '../components/StatusPill.astro';
import { recruitment, siteData } from '../data/site';
import { getRecruitmentStatus } from '../lib/status';
const status =
  recruitment.opensAt && recruitment.closesAt
    ? getRecruitmentStatus(recruitment.opensAt, recruitment.closesAt)
    : 'upcoming';
const statusCopy = { upcoming: '即将开始', open: '正在进行', closed: '本轮招新暂时结束啦。' };
const faq = [
  ['不会编程可以加入吗？', '可以。兴趣比起点更重要，第一次接触编程也有适合你的入口。'],
  ['非计算机专业可以加入吗？', '可以。只要你对计算机、项目、比赛或内容创作感兴趣，欢迎来认识我们。'],
  ['一定要参加比赛吗？', '不需要。你可以学习、交流，也可以从一个感兴趣的小问题开始。'],
  ['平时有什么安排？', '我们会定期整理技术文章与学习资料，并在社群中同步各类交流机会。'],
  ['需要自带电脑吗？', '不同活动要求不同，具体信息会写在活动详情里。'],
  ['怎样联系协会？', '招新开放时，Join 页面会显示当期可用的报名和交流群入口。'],
];
---

<BaseLayout title={`Join CXCS · ${siteData.shortName}`} description="不会编程没关系。有兴趣，就已经是一个很好的开始。">
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div>
        <p class="eyebrow">Join CXCS</p><h1>来一起<br />做点有意思的事。</h1><p class="page-hero-copy">
          不需要一开始就知道自己想做什么。如果你对计算机感兴趣，可以先来看看。
        </p>
      </div><div class="page-hero-art join-art" aria-hidden="true"><span>+</span></div>
    </div>
  </section>
  <section class="band">
    <div class="container">
      <div class="section-head-row">
        <SectionIntro
          eyebrow="Who Is It For"
          title="你可以从任何地方开始。"
          description="或者你只是觉得这些看起来挺有意思的。"
        />
      </div><div class="audience-grid">
        <article class="audience-card">
          <strong>01</strong><h3>第一次接触编程</h3><p>想学，但不知道从哪里开始。</p>
        </article><article class="audience-card">
          <strong>02</strong><h3>已经会一点</h3><p>想找人一起做项目、交流或参加比赛。</p>
        </article><article class="audience-card">
          <strong>03</strong><h3>喜欢折腾电脑</h3><p>软件、硬件、服务器、开发板都想碰一碰。</p>
        </article><article class="audience-card">
          <strong>04</strong><h3>喜欢做内容</h3><p>文章、设计、漫画、小剧场、宣传同样欢迎。</p>
        </article>
      </div>
    </div>
  </section>
  <section class="band band-soft">
    <div class="container">
      <SectionIntro eyebrow="What You Can Do" title="加入以后，可以做很多事。" /><div class="join-capabilities">
        <article><span>Learn</span><h3>跟着 Guide 学点东西</h3></article><article>
          <span>Build</span><h3>参与项目或做自己的项目</h3>
        </article><article><span>Deploy</span><h3>用 CXCS Page 发布网站</h3></article><article>
          <span>Compete</span><h3>和队友一起参加比赛</h3>
        </article><article><span>Share</span><h3>做分享、写文章</h3></article><article>
          <span>Create</span><h3>制作小剧场和其他内容</h3>
        </article>
      </div>
    </div>
  </section>
  <section class="band">
    <div class="container">
      <div class="join-grid">
        <div><p class="eyebrow">Community Expectation</p><h2>加入计协<br />≠ 来上课。</h2></div><div class="about-copy">
          <p>我们会分享知识，也会整理学习资料。但计算机协会不是培训班。</p><p>
            你可以跟大家一起学，也可以自己研究；可以参加项目，也可以只是来交流。
          </p><ArrowLink href="/about" label="更多关于 CXCS" />
        </div>
      </div><div class={`recruitment-panel status-panel-${status}`}>
        <div>
          <StatusPill status={status} recruitmentStart={recruitment.opensAt} recruitmentEnd={recruitment.closesAt} /><h3
          >
            {recruitment.title}
          </h3><p>{statusCopy[status]}</p>{
            recruitment.opensAt && recruitment.closesAt && (
              <p class="recruitment-dates">
                <Clock3 size={14} />
                {new Date(recruitment.opensAt).toLocaleDateString('zh-CN')} —{' '}
                {new Date(recruitment.closesAt).toLocaleDateString('zh-CN')}
              </p>
            )
          }
        </div><div class="recruitment-actions">
          {
            status === 'open' && (
              <>
                {recruitment.applicationUrl && (
                  <a
                    class="button button-primary"
                    href={recruitment.applicationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    立即报名 <ArrowUpRight size={16} />
                  </a>
                )}
                {recruitment.groupUrl && (
                  <a
                    class="button button-secondary"
                    href={recruitment.groupUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    加入招新群 <ArrowUpRight size={16} />
                  </a>
                )}
              </>
            )
          }{
            status === 'upcoming' && (
              <a class="button button-secondary" href="/articles">
                浏览最新文章 <ArrowRight size={16} />
              </a>
            )
          }{
            status === 'closed' && (
              <>
                <>
                  <a class="button button-secondary" href="/articles">
                    浏览最新文章 <ArrowRight size={16} />
                  </a>
                  <a class="button button-secondary" href={siteData.guideUrl} target="_blank" rel="noopener noreferrer">
                    打开 Guide <ArrowUpRight size={16} />
                  </a>
                </>
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>
  <section class="band band-soft">
    <div class="container">
      <SectionIntro
        eyebrow="How to Join"
        title="如果你还没想好，也没关系。"
        description="先看看最新文章，或从一份新手资料开始。"
      /><div class="join-steps">
        <article><b>01</b><div><h3>查看本次招新信息</h3><p>确认当前状态和可用入口。</p></div></article><article>
          <b>02</b><div><h3>填写报名或加入招新群</h3><p>只使用页面上真实存在的入口。</p></div>
        </article><article>
          <b>03</b><div><h3>加入交流</h3><p>先认识大家，再决定下一步。</p></div>
        </article><article><b>04</b><div><h3>欢迎来到 CXCS</h3><p>从你觉得有意思的地方开始。</p></div></article>
      </div>
    </div>
  </section>
  <section class="band">
    <div class="container">
      <SectionIntro eyebrow="FAQ" title="先回答几个常见问题。" /><div class="faq">
        {
          faq.map(([question, answer]) => (
            <details>
              <>
                <summary>{question}</summary>
                <p>{answer}</p>
              </>
            </details>
          ))
        }
      </div><div class="not-sure">
        <Users size={20} /><div>
          <h3>还没想好？没关系。</h3><div class="not-sure-links">
            <ArrowLink href="/articles" label="浏览最新文章" />
            <ArrowLink href="/about" label="了解计算机协会" />
            <ArrowLink href={siteData.guideUrl} label="打开新手 Guide" external />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
