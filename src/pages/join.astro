---
import Button from '../components/Button.astro';
import { ArrowDown, ArrowRight, ArrowUpRight, CodeXml, Copy, MessagesSquare, Trophy, Wrench } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../widgets/PageHero.astro';
import config from '../config';
import { getRecruitmentStatus, type RecruitmentStatus } from '../status';

const { recruitment, site } = config;
const status =
  recruitment.opensAt && recruitment.closesAt
    ? getRecruitmentStatus(recruitment.opensAt, recruitment.closesAt)
    : recruitment.status;

const statusLabels: Record<RecruitmentStatus, string> = {
  open: '招新进行中',
  upcoming: '招新即将开始',
  closed: '本轮招新已结束',
};

const activities = [
  {
    num: '01 / LEARN',
    title: '一起学编程',
    description: '从 C 语言、Python 到网页开发，分享学习资料，遇到问题一起讨论。刚开始学也没关系。',
    icon: CodeXml,
  },
  {
    num: '02 / COMPETE',
    title: '参加比赛',
    description: '了解程序设计竞赛，参加算法讲座和校内练习，也可以找伙伴一起备赛。',
    icon: Trophy,
  },
  {
    num: '03 / BUILD',
    title: '动手做点东西',
    description: '写一个小工具、做一个网站，或是组装一台电脑。把学到的知识用起来，也和大家分享你的作品。',
    icon: Wrench,
  },
  {
    num: '04 / SHARE',
    title: '认识聊得来的朋友',
    description: '聊学习方法、装机配置，也聊最近在折腾什么。有人一起交流，学习和尝试都会更有意思。',
    icon: MessagesSquare,
  },
];

const steps = [
  { title: '复制群号', description: '点击复制按钮，或直接记下旁边的 QQ 群号。' },
  { title: '在 QQ 中搜索并申请加入', description: '打开 QQ 的找群功能，输入群号，按页面提示发送加群申请。' },
  { title: '进群后查看群公告', description: '报名和活动安排以群内通知为准。有不清楚的地方，可以直接在群里问。' },
];

const faqs = [
  {
    question: '完全不会编程，可以加入吗？',
    answer: '可以。加入协会不要求编程基础，你可以先从入门资料看起，遇到问题在群里交流。',
  },
  {
    question: '不是计算机专业，也能参加吗？',
    answer: '能。我们欢迎全校各年级、各专业的同学，只要你对计算机感兴趣。',
  },
  {
    question: '需要交会费吗？',
    answer: '不需要，协会不收取会费。',
  },
  {
    question: '加入后必须参加所有活动吗？',
    answer: '不用。根据自己的兴趣和时间选择活动就好，具体时间和参加方式会在群里通知。',
  },
];
---

<BaseLayout>
  <PageHero
    eyebrow="JOIN US"
    title="欢迎加入计算机协会。"
    description="想学编程、参加比赛，或者找人一起做项目，都欢迎来计协看看。不限专业，也不要求你已经会写代码。"
    class="join-hero"
  >
    <Fragment slot="title">
      欢迎加入
      <br />
      计算机协会。
    </Fragment>
    <div slot="meta" class="hero-meta">
      <Button href="#join-group">
        查看加群方式 <ArrowDown size={14} />
      </Button>
      <span class={`recruitment-status status-${status}`}>
        <span class="status-dot" aria-hidden="true"></span>
        {statusLabels[status]}
      </span>
      <div class="hero-artwork" aria-hidden="true">
        <span class="hero-word">
          JOIN
          <br />
          <span>US.</span>
        </span>
        <img src="/assets/characters/shurin-aran/hero.png" alt="" width="1024" height="1536" fetchpriority="high" />
      </div>
    </div>
  </PageHero>

  <section class="section wrap" id="join-group" aria-labelledby="group-title">
    <div class="section-line">HOW TO JOIN</div>
    <div class="section-heading">
      <h2 id="group-title">先加群，认识一下。</h2>
      <p>想加入协会，或是想先了解一下，都可以进招新群。报名和活动消息会在群里通知。</p>
    </div>

    <div class="join-layout">
      <div class="group-card">
        <div class="group-card-top">
          <span>{recruitment.title}</span>
          <ArrowUpRight size={20} aria-hidden="true" />
        </div>
        <h3>计协招新 QQ 群</h3>
        <p class="group-number" id="qq-group-number">
          {recruitment.qqGroup}
        </p>
        <Button
          type="button"
          class="copy-button"
          variant="secondary"
          data-copy-group={recruitment.qqGroup}
          aria-describedby="copy-feedback"
          hidden
        >
          <Copy size={15} />
          <span data-copy-label>复制群号</span>
        </Button>
        <p class="copy-feedback" id="copy-feedback" role="status" aria-live="polite">
          在 QQ 中搜索这个群号，即可申请加入。
        </p>
      </div>

      <ol class="join-steps">
        {steps.map((step, index) => (
          <li>
            <span class="step-number" aria-hidden="true">
              0{index + 1}
            </span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section activities-section" aria-labelledby="activities-title">
    <div class="wrap">
      <div class="section-line">LEARN / BUILD / SHARE</div>
      <div class="section-heading">
        <h2 id="activities-title">在计协，可以做些什么？</h2>
        <a class="small-link" href="/articles/news">
          看看往期活动 <ArrowRight size={14} />
        </a>
      </div>
      <div class="activities-grid">
        {activities.map(({ num, title, description, icon: Icon }) => (
          <article class="activity-card">
            <div class="activity-card-top">
              <span>{num}</span>
              <Icon size={25} stroke-width={1.5} aria-hidden="true" />
            </div>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap faq-section" aria-labelledby="faq-title">
    <div class="faq-intro">
      <div class="section-line">Q & A</div>
      <h2 id="faq-title">你可能还想问</h2>
      <p>这里没有提到的问题，欢迎进群聊聊。</p>
      <a class="small-link" href="#join-group">
        查看招新群号 <ArrowUpRight size={14} />
      </a>
    </div>
    <div class="faq-list">
      {faqs.map(({ question, answer }) => (
        <details class="faq-item">
          <summary>
            <span>{question}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="guide-section" aria-labelledby="guide-title">
    <div class="wrap guide-inner">
      <div>
        <div class="section-line">GET STARTED</div>
        <h2 id="guide-title">想先学点什么？</h2>
        <p>CXCS Guide 整理了编程入门和学习资料，可以从你感兴趣的内容开始看。</p>
      </div>
      <Button href={site.guideUrl} external>
        打开学习指南 <ArrowUpRight size={14} />
      </Button>
    </div>
  </section>
</BaseLayout>

<script>
  import { onPageLoad } from '../assets/scripts/page-load';

  onPageLoad(() => {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-group]');
    const feedback = document.querySelector<HTMLElement>('#copy-feedback');
    const label = button?.querySelector<HTMLElement>('[data-copy-label]');
    if (!button || !feedback || !label) return;

    button.hidden = false;
    button.onclick = async () => {
      const group = button.dataset.copyGroup;
      if (!group) return;

      try {
        await navigator.clipboard.writeText(group);
        label.textContent = '已复制群号';
        feedback.textContent = '群号已复制，打开 QQ 搜索并申请加入吧。';
      } catch {
        label.textContent = '重新复制';
        feedback.textContent = `未能自动复制，请长按或选中群号 ${group} 手动复制。`;
      }
    };
  });
</script>

<style>
  :global(.join-hero .page-hero-copy) {
    max-width: min(520px, 48%);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 24px;
  }

  .recruitment-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--muted);
  }

  .status-open {
    color: var(--blue);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .hero-artwork {
    position: absolute;
    z-index: -1;
    top: var(--header-height);
    bottom: 0;
    right: max(56px, calc((100% - 1296px) / 2));
    width: 42%;
    max-width: 530px;
    pointer-events: none;
    user-select: none;
  }

  .hero-word {
    position: absolute;
    top: 18px;
    left: 0;
    font-size: clamp(100px, 10vw, 146px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.06em;
    color: var(--blue);
  }

  .hero-word > span {
    color: var(--text);
  }

  .hero-artwork img {
    position: absolute;
    right: 0;
    bottom: -64px;
    height: 430px;
    width: auto;
    max-width: none;
    filter: drop-shadow(0 18px 24px rgba(36, 100, 237, 0.1));
  }

  #join-group {
    scroll-margin-top: calc(var(--header-height) + 24px);
  }

  .join-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
  }

  .group-card {
    padding: 32px;
    border: 1px solid #2464ed;
    border-radius: var(--radius-md);
    background: #2464ed;
    color: #fff;
  }

  .group-card-top,
  .activity-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 11px;
    letter-spacing: 0.04em;
    margin-bottom: 28px;
  }

  .group-card-top {
    color: #e5edff;
  }

  .group-card h3 {
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 8px;
  }

  .group-number {
    font-size: clamp(32px, 4.3vw, 60px);
    line-height: 1.2;
    font-weight: 650;
    letter-spacing: 0.025em;
    font-variant-numeric: tabular-nums;
    user-select: all;
    margin: 0 0 28px;
  }

  .group-card :global(.copy-button) {
    color: #1b53c7;
    background: #fff;
    border-color: #fff;
  }

  .group-card :global(.copy-button:hover) {
    background: #eef4ff;
    border-color: #eef4ff;
  }

  .group-card :global(.copy-button:focus-visible) {
    outline-color: #fff;
  }

  .group-card :global(.copy-button[hidden]) {
    display: none;
  }

  .copy-feedback {
    min-height: 1.8em;
    color: #e5edff;
    font-size: 12px;
    line-height: 1.8;
    margin: 16px 0 0;
  }

  .join-steps {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .join-steps li {
    display: flex;
    gap: 22px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .join-steps li:first-child {
    padding-top: 0;
  }

  .join-steps li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .step-number {
    color: var(--orange);
    font-size: 12px;
    font-weight: 600;
    padding-top: 4px;
  }

  .join-steps h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px;
  }

  .join-steps p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    margin: 0;
  }

  .activities-section {
    border-block: 1px solid var(--line);
  }

  .activities-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 15px;
  }

  .activity-card {
    grid-column: span 5;
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .activity-card:first-child,
  .activity-card:last-child {
    grid-column: span 7;
  }

  .activity-card:first-child {
    background: #2464ed;
    color: #fff;
    border-color: #2464ed;
  }

  .activity-card:last-child {
    background: var(--ice);
  }

  .activity-card-top {
    color: var(--muted);
    margin-bottom: 32px;
  }

  .activity-card h3 {
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 12px;
  }

  .activity-card p {
    max-width: 440px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.85;
    margin: 0;
  }

  .activity-card:first-child .activity-card-top,
  .activity-card:first-child p {
    color: #e5edff;
  }

  .faq-section {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 64px;
  }

  .faq-intro h2,
  .guide-inner h2 {
    font-size: clamp(28px, 3.2vw, 39px);
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 16px;
  }

  .faq-intro p,
  .guide-inner p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    margin: 0 0 24px;
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    font-size: 16px;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    flex: 0 0 16px;
    color: var(--blue);
    text-align: center;
  }

  .faq-icon::before {
    content: '+';
    font-size: 22px;
    line-height: 1;
  }

  .faq-item[open] .faq-icon::before {
    content: '−';
  }

  .faq-item p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.85;
    margin: 0;
    padding: 0 40px 24px 0;
  }

  .guide-section {
    background: var(--ice);
    padding: 64px 0;
  }

  .guide-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 36px;
  }

  .guide-inner p {
    margin-bottom: 0;
  }

  .guide-inner :global(.button) {
    flex-shrink: 0;
  }

  @media (max-width: 960px) {
    .hero-artwork {
      right: 24px;
      width: 35%;
    }

    .hero-word {
      display: none;
    }

    .hero-artwork img {
      height: 360px;
      bottom: -30px;
    }

    :global(.join-hero .page-hero-copy) {
      max-width: 58%;
    }

    .faq-section {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 680px) {
    .hero-artwork {
      display: none;
    }

    :global(.join-hero .page-hero-copy) {
      max-width: 100%;
    }

    .section-heading,
    .guide-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .section-heading h2 {
      font-size: 28px;
    }

    .join-layout,
    .activities-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .activities-grid {
      gap: 15px;
    }

    .activity-card,
    .activity-card:first-child,
    .activity-card:last-child {
      grid-column: auto;
    }

    .group-card,
    .activity-card {
      padding: 24px;
    }

    .group-number {
      font-size: clamp(28px, 8.8vw, 48px);
    }

    .section {
      padding-block: 52px;
    }
  }
</style>
